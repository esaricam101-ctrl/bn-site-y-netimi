// ---------------------------------------------------------------------------
// BNOS Apartman Yönetimi — Prisma şeması
//
// Kaynaklar:
//   ADR-0002  tenant = apartman · PostgreSQL RLS
//   ADR-0003  çift taraflı muhasebe
//   ADR-0007  para = ölçeklenmiş bigint (numeric(18,4))
//   BFS v1 §4 zaman: DATE vs timestamptz
//   BFS v1 §5 silme: FINANSAL / ANA_VERI / BELGE
//
// KRİTİK: RLS politikaları ve kısmi unique index'ler migration SQL'indedir.
// Prisma bunları şemadan üretemez — migration/0001_init/migration.sql'e bakın.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// TENANT — RLS taşımaz (katalog tablosu). Erişim uygulama katmanında denetlenir.
// ===========================================================================

enum TenantTipi {
  APARTMAN
  SITE
  YONETIM_SIRKETI
}

enum TenantDurumu {
  KURULUM
  AKTIF
  ASKIDA
  ARSIV
}

model Tenant {
  id          String       @id @db.Uuid
  kod         String       @unique @db.VarChar(32)
  ad          String       @db.VarChar(120)
  tip         TenantTipi   @default(APARTMAN)
  durum       TenantDurumu @default(KURULUM)
  /// BFS v1 §4.2 — Türkiye sabit UTC+3'tür ancak koda gömülmez, tenant ayarıdır.
  saatDilimi  String       @default("Europe/Istanbul") @map("saat_dilimi") @db.VarChar(64)
  paraBirimi  String       @default("TRY") @map("para_birimi") @db.Char(3)
  lisansKodu  String       @map("lisans_kodu") @db.VarChar(32)

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  kisiler          Kisi[]
  kullanicilar     Kullanici[]
  oturumDizini     OturumDizini[]
  araclar          Arac[]
  sayaclar         Sayac[]
  sayacOkumalari   SayacOkumasi[]
  belgeler         Belge[]
  belgePolitikalari BelgeTipiPolitikasi[]
  belgeIliskileri  BelgeIliskisi[]
  belgeEtiketleri  BelgeEtiketi[]
  daireGorevlileri DaireGorevlisi[]
  misafirler       Misafir[]
  sitePersonelleri     SitePersoneli[]
  personelSertifikalari PersonelSertifikasi[]
  personelZimmetleri    PersonelZimmeti[]
  apartmanlar      Apartman[]
  bloklar          Blok[]
  katlar           Kat[]
  bagimsizBolumler BagimsizBolum[]
  malikler         Malik[]
  kiracilar        Kiraci[]
  sakinler         Sakin[]
  giderTurleri     GiderTuru[]
  hesaplar         Hesap[]
  yevmiyeler       YevmiyeFisi[]
  muhasebeDonemleri MuhasebeDonemi[]
  muhasebeParametresi MuhasebeParametresi?
  borclar          Borc[]
  auditKayitlari   AuditKaydi[]
  outboxKayitlari  OutboxKayit[]
  numaraSayaclari  NumaraSayaci[]
  isCalistirmalari IsCalistirma[]

  // --- Banka çekirdeği (0016) ---
  bankalar         Banka[]
  bankaSubeleri    BankaSubesi[]
  bankaHesaplari   BankaHesabi[]
  posTanimlari     PosTanimi[]
  bankaHareketleri BankaHareketi[]
  bankaEkstreleri  BankaEkstresi[]
  ekstreSatirlari  EkstreSatiri[]
  kiymetliEvraklar KiymetliEvrak[]
  bankaParametresi BankaParametresi?

  // --- Tahsilat / cari yardımcı defteri (0017 · ADR-0010) ---
  tahsilatlar        Tahsilat[]
  tahsilatTahsisleri TahsilatTahsisi[]

  // --- Geri alma (0018) ---
  geriAlmalar GeriAlma[]

  // --- İletişim çekirdeği (0019) — WhatsApp · SMS ---
  mesajSablonlari   MesajSablonu[]
  iletisimIzinleri  IletisimIzni[]
  mesajGonderimleri MesajGonderimi[]
  mesajlar          Mesaj[]
  bildirimKurallari OtomatikBildirimKurali[]

  /// Bu tenant bir YÖNETİM FİRMASI ise: yönettiği projeler (ADR-0009).
  yonettigiProjeler YonetimDelegasyonu[] @relation("DevirAlan")
  /// Bu tenant bir PROJE ise: yönetimini devrettiği firma kaydı.
  devirKayitlari    YonetimDelegasyonu[] @relation("DevirVeren")

  @@map("tenant")
}

/// Devrin durumu. Sona ermiş devir SİLİNMEZ — hangi firmanın hangi tarihte
/// yetkili olduğu, geçmişe dönük her tahakkukun dayanağıdır.
enum DevirDurumu {
  AKTIF
  SONA_ERDI
  IPTAL
}

/// Yönetim devri — PORTFÖY YÖNETİM MERKEZİ'nin veri temeli (ADR-0009).
///
/// Yönetim firması bir tenant'tır; proje de bir tenant'tır (ADR-0008).
/// Aralarındaki bağ bu AÇIK DEVİR kaydıdır.
///
/// ⚠️  ÇAPRAZ-TENANT SORGUYA KAPI AÇMAZ. ADR-0002 portföy görünümünün
///     "RLS gevşetilerek çözülmeyeceğini" ve çözüm yolunun tam olarak bu devir
///     ilişkisi olduğunu şimdiden yazmıştı. Portföy özeti PROJE BAŞINA ayrı
///     sorgu + uygulama katmanında toplamadır; bedeli ADR-0002'de kabul edildi.
///
/// ⚠️  RLS politikası İKİ TARAFLIDIR (`yonetim_tenant_id = app_tenant_id() OR
///     proje_tenant_id = app_tenant_id()`): satırın iki tenant'ı vardır ve
///     ikisi de kendi tarafını görmek zorundadır. Açığa çıkan tek şey devir
///     olgusudur, projenin verisi değil.
model YonetimDelegasyonu {
  id String @id @db.Uuid

  /// Yönetimi DEVRALAN firma tenant'ı (tip = YONETIM_SIRKETI).
  yonetimTenantId String @map("yonetim_tenant_id") @db.Uuid
  /// Yönetimi DEVREDEN proje tenant'ı (tip = APARTMAN | SITE).
  projeTenantId   String @map("proje_tenant_id") @db.Uuid

  durum DevirDurumu @default(AKTIF)

  /// Devrin dayanağı: yönetim sözleşmesi no, genel kurul kararı vb. ZORUNLU —
  /// dayanağı olmayan devir, hangi kararla verildiği sorulduğunda cevapsız
  /// kalır (KMK md. 34 · yönetici seçimi).
  dayanak String @db.VarChar(200)

  baslangic DateTime  @db.Date
  /// Boşsa devir SÜRESİZDİR.
  bitis     DateTime? @db.Date

  verenKullanici        String? @map("veren_kullanici") @db.Uuid
  sonaErdirmeGerekcesi  String? @map("sona_erdirme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  yonetimTenant Tenant @relation("DevirAlan", fields: [yonetimTenantId], references: [id], onDelete: Restrict)
  projeTenant   Tenant @relation("DevirVeren", fields: [projeTenantId], references: [id], onDelete: Restrict)

  @@index([yonetimTenantId, durum])
  @@index([projeTenantId, durum])
  @@map("yonetim_delegasyonu")
}

// ===========================================================================
// KİŞİ ve KULLANICI — ANA_VERI sınıfı → soft delete (BFS v1 §5)
// ===========================================================================

enum Cinsiyet {
  KADIN
  ERKEK
  BELIRTILMEMIS
}

model Kisi {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  ad       String  @db.VarChar(60)
  soyad    String  @db.VarChar(60)
  eposta   String? @db.VarChar(180)
  telefon  String? @db.VarChar(32)
  /// KVKK: anonimleştirmede geri döndürülemez şekilde temizlenir (Sprint 9).
  tcKimlikNo String? @map("tc_kimlik_no") @db.VarChar(11)
  anonimMi   Boolean @default(false) @map("anonim_mi")

  /// Hızlı kayıtta girilebilen alanlar. Hepsi İSTEĞE BAĞLI: KVKK veri
  /// minimizasyonu (md. 4/1-ç) — doğum tarihi ve cinsiyet aidat tahakkuku
  /// için gerekli değildir.
  /// WhatsApp numarası — `telefon`dan ayrı tutulur (0019).
  whatsappNo  String?   @map("whatsapp_no") @db.VarChar(24)
  dogumTarihi DateTime? @map("dogum_tarihi") @db.Date
  cinsiyet    Cinsiyet  @default(BELIRTILMEMIS)
  adres       String?
  notlar      String?

  // --- Soft delete standardı (BFS v1 §5.2) ---
  silindiMi       Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi   DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici  String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi  String?   @map("silme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  kullanici       Kullanici?
  bolumIliskileri BolumIliskisi[]
  borcSorumluluk  BorcSorumlusu[]
  maliklikleri    Malik[]          @relation("MalikKisi")
  vekillikleri    Malik[]          @relation("MalikVekil")
  kiraciliklari   Kiraci[]
  sakinlikleri    Sakin[]
  araclari        Arac[]
  /// Bu kişinin İŞVEREN olarak çalıştırdığı daire görevlileri (bakıcı,
  /// ev yardımcısı…). Görevlinin kendisi `Kisi` DEĞİLDİR; buradaki ilişki
  /// yalnızca işvereni gösterir.
  calistirdigiGorevliler DaireGorevlisi[] @relation("GorevliIsvereni")
  /// Bu kişinin BORÇLUSU olduğu çek/senetler (0016). Dışarıdan gelen çekin
  /// borçlusu kişi kaydı olmayabilir; bağ isteğe bağlıdır.
  borclusuOlduguEvraklar KiymetliEvrak[]
  /// Bu kişinin FİİLEN ÖDEDİĞİ tahsilatlar (0017). Ödeyen, borçlu ile aynı
  /// olmak zorunda DEĞİLDİR: komşusu ya da akrabası adına ödeme yapılabilir.
  odedigiTahsilatlar     Tahsilat[]
  /// İletişim (0019). WhatsApp numarası `telefon`dan FARKLI olabilir: iş
  /// telefonu SMS alır ama WhatsApp kişisel numaradadır. Tek alan kullanılsaydı
  /// biri mutlaka yanlış olurdu.
  iletisimIzinleri       IletisimIzni[]
  mesajlar               Mesaj[]

  @@index([tenantId, soyad, ad])
  @@map("kisi")
}

model Kullanici {
  id        String  @id @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  kisiId    String  @unique @map("kisi_id") @db.Uuid
  eposta    String  @db.VarChar(180)
  sifreHash String  @map("sifre_hash") @db.VarChar(255)
  aktif     Boolean @default(true)

  silindiMi      Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi  DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi String?   @map("silme_gerekcesi")

  sonGirisAni       DateTime? @map("son_giris_ani") @db.Timestamptz(6)
  olusturulmaTarihi DateTime  @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime  @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant Tenant             @relation(fields: [tenantId], references: [id])
  kisi   Kisi               @relation(fields: [kisiId], references: [id])
  roller KullaniciRolu[]

  @@map("kullanici")
}

/// Oturum dizini — e-posta → tenant eşlemesi. RLS TAŞIMAZ.
///
/// Giriş, tenant'ı bilmeden kullanıcıyı bulmak zorundadır; `kullanici` tablosu
/// RLS taşıdığı için tenant bağlamı kurulmadan okunamaz. Bu tablo `tenant` ile
/// aynı gerekçeli istisnadır (BFS v1 §2.4).
///
/// PAROLA TUTMAZ. Parola doğrulaması tenant bağlamı kurulduktan SONRA
/// `kullanici` üzerinde yapılır.
///
/// Senkronu veritabanı TRIGGER'ı tutar (`kullanici_oturum_dizini`), uygulama
/// kodu değil: yeni bir kullanıcı oluşturma yolu eklendiğinde dizine yazmayı
/// unutmak, o kullanıcının SESSİZCE giriş yapamaması demekti.
model OturumDizini {
  kullaniciId String @id @map("kullanici_id") @db.Uuid
  eposta      String @db.VarChar(180)
  tenantId    String @map("tenant_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("oturum_dizini")
}

model KullaniciRolu {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  kullaniciId String @map("kullanici_id") @db.Uuid
  /// core-domain ROLLER kataloğundaki kod.
  rolKodu     String @map("rol_kodu") @db.VarChar(40)

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)

  @@unique([kullaniciId, rolKodu])
  @@map("kullanici_rolu")
}

// ===========================================================================
// YAPI — Blok ve Bağımsız Bölüm (KMK)
// ===========================================================================

enum BolumNiteligi {
  MESKEN
  ISYERI
  DEPO
  OTOPARK
  ORTAK_ALAN
}

/// ADR-0008 — Tenant bir apartman ya da bir SİTE olabilir. Site birden çok
/// apartman taşır; tek apartmanlı tenant'ta bu tabloda bir kayıt bulunur.
/// Tenant SINIRI AŞILMAZ: bütün hiyerarşi aynı tenant_id altındadır.
model Apartman {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  ad       String  @db.VarChar(120)
  adres    String?
  /// Site içindeki kısa kod — 'A', 'Kuzey' gibi. Site dışı tenant'ta boş kalır.
  siteIciKod String? @map("site_ici_kod") @db.VarChar(16)

  silindiMi      Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi  DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi String?   @map("silme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  bloklar Blok[]

  personeller SitePersoneli[]
  @@index([tenantId])
  @@map("apartman")
}

model Blok {
  id         String @id @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  /// Üst kayıt olmadan alt kayıt oluşturulamaz — blok daima bir apartmana bağlıdır.
  apartmanId String @map("apartman_id") @db.Uuid
  ad         String @db.VarChar(40)

  silindiMi      Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi  DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi String?   @map("silme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  apartman Apartman        @relation(fields: [apartmanId], references: [id])
  katlar   Kat[]
  bolumler BagimsizBolum[]

  @@index([tenantId, apartmanId])
  @@map("blok")
}

/// Kat, blok içindeki düzeydir. `no` negatif olabilir (bodrum).
model Kat {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  blokId   String @map("blok_id") @db.Uuid
  no       Int
  ad       String? @db.VarChar(40)

  silindiMi      Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi  DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi String?   @map("silme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  blok     Blok            @relation(fields: [blokId], references: [id])
  bolumler BagimsizBolum[]

  @@index([tenantId, blokId])
  @@map("kat")
}

model BagimsizBolum {
  id       String        @id @db.Uuid
  tenantId String        @map("tenant_id") @db.Uuid
  blokId   String?       @map("blok_id") @db.Uuid
  katId    String?       @map("kat_id") @db.Uuid
  kapiNo   String        @map("kapi_no") @db.VarChar(16)
  /// Bina dışından görünen kapı no ile daire içi numara farklı olabilir.
  icKapiNo String?       @map("ic_kapi_no") @db.VarChar(16)
  /// Kat numarası; `katId` verildiğinde onunla tutarlı olmalıdır.
  kat      Int
  /// Tapudaki hukuki vasıf. Değişmez.
  nitelik  BolumNiteligi @default(MESKEN)
  /// 1+1, 2+1 gibi. Serbest metin değil — raporlanabilir olsun diye enum.
  daireTipi DaireTipi?   @map("daire_tipi")
  /// Fiili kullanım amacı: 'konut', 'muayenehane' gibi. `nitelik`ten ayrıdır.
  kullanimAmaci String?  @map("kullanim_amaci") @db.VarChar(80)
  /// Günlük işletme durumu. `nitelik` hukuki, `durum` fiilidir.
  durum    BolumDurumu   @default(AKTIF)
  brutM2   Decimal       @map("brut_m2") @db.Decimal(10, 2)
  netM2    Decimal       @map("net_m2") @db.Decimal(10, 2)

  /// --- Tapu bilgileri (KMK md. 12) ---
  tapuAda            String? @map("tapu_ada") @db.VarChar(20)
  tapuParsel         String? @map("tapu_parsel") @db.VarChar(20)
  tapuPafta          String? @map("tapu_pafta") @db.VarChar(20)
  /// Tapudaki bağımsız bölüm numarası; kapı numarasından FARKLI olabilir.
  tapuBagimsizBolumNo String? @map("tapu_bagimsiz_bolum_no") @db.VarChar(20)
  tapuCilt           String? @map("tapu_cilt") @db.VarChar(20)
  tapuSahife         String? @map("tapu_sahife") @db.VarChar(20)
  /// Arsa payı pay/payda olarak tutulur — ondalık yuvarlama hatası olmasın (KMK md. 3).
  arsaPayiPay    BigInt  @map("arsa_payi_pay")
  arsaPayiPayda  BigInt  @map("arsa_payi_payda")
  aidatMuafiyeti Boolean @default(false) @map("aidat_muafiyeti")

  silindiMi      Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi  DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi String?   @map("silme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  blok      Blok?           @relation(fields: [blokId], references: [id])
  katKaydi  Kat?            @relation(fields: [katId], references: [id])
  iliskiler BolumIliskisi[]
  malikler  Malik[]
  kiracilar Kiraci[]
  sakinler  Sakin[]
  borclar   Borc[]
  araclar   Arac[]
  sayaclar  Sayac[]
  misafirler Misafir[]
  daireGorevlileri DaireGorevlisi[]

  @@index([tenantId, blokId])
  @@index([tenantId, katId])
  @@map("bagimsiz_bolum")
}

enum DaireTipi {
  STUDYO
  BIR_SIFIR
  BIR_BIR
  IKI_BIR
  UC_BIR
  DORT_BIR
  BES_BIR
  DUBLEKS
  DIGER
}

enum BolumDurumu {
  AKTIF
  BOS
  TADILATTA
  KULLANIM_DISI
}

enum IliskiRolu {
  MALIK
  KIRACI
  /// Fiilen oturan. Malik ve kiracıdan AYRIDIR: kiracı şirket olabilir,
  /// dairede oturan çalışanı olabilir. `SAKINE_AIT` giderlerin borç
  /// sorumlusu bu roldür.
  SAKIN
}

model BolumIliskisi {
  id       String     @id @db.Uuid
  tenantId String     @map("tenant_id") @db.Uuid
  bolumId  String     @map("bolum_id") @db.Uuid
  kisiId   String     @map("kisi_id") @db.Uuid
  rol      IliskiRolu
  /// BFS v1 §4.1 — takvim tarihi, saat dilimsiz DATE.
  baslangic DateTime  @db.Date
  bitis     DateTime? @db.Date

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)

  bolum BagimsizBolum @relation(fields: [bolumId], references: [id])
  kisi  Kisi          @relation(fields: [kisiId], references: [id])

  @@index([tenantId, bolumId, rol])
  @@map("bolum_iliskisi")
}

// ===========================================================================
// MALİK · KİRACI · SAKİN
//
// Üçü AYRI kavramdır ve karıştırılmaz:
//   Malik  — tapu sahibi. Birden çok olabilir, hisselidir, oturmayabilir.
//   Kiracı — kira sözleşmesinin tarafı. Oturmayabilir (şirket kiracı olabilir).
//   Sakin  — fiilen oturan. Malik, kiracı ya da onların yakını olabilir.
//
// HİÇBİRİ SİLİNMEZ. Geçmiş kayıtlar tarihçe olarak kalır; ilişki `bitis`
// tarihi alarak kapanır. Borç sorumluluğu borcun oluştuğu anda çözülüp
// yazılır (snapshot) — geçmişi silmek o kaydın dayanağını yok eder.
// ===========================================================================

enum TapuTuru {
  KAT_MULKIYETI
  KAT_IRTIFAKI
  ARSA_PAYLI
  MIRAS_ISTIRAK
  DIGER
}

/// Hisseli mülkiyet. Aynı bölümde aynı tarihte birden çok malik GEÇERLİDİR;
/// koruma tekillik değil, hisse toplamının tamı etmesidir (KMK md. 3 deseni).
model Malik {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  bolumId  String @map("bolum_id") @db.Uuid
  kisiId   String @map("kisi_id") @db.Uuid

  /// Hisse pay/payda olarak tutulur; ondalık yüzde 1/3'te toplamı bozar (ADR-0007).
  hissePay   BigInt @map("hisse_pay")
  hissePayda BigInt @map("hisse_payda")

  tapuTuru       TapuTuru  @default(KAT_MULKIYETI) @map("tapu_turu")
  /// BFS v1 §4.1 — takvim tarihi, saat dilimsiz DATE.
  tapuBaslangic  DateTime  @map("tapu_baslangic") @db.Date
  tapuBitis      DateTime? @map("tapu_bitis") @db.Date
  tapuYevmiyeNo  String?   @map("tapu_yevmiye_no") @db.VarChar(40)

  /// Vekil de bir kişidir; vekâletname referansı ayrı tutulur (C-4 hukuki görüş).
  vekilKisiId       String? @map("vekil_kisi_id") @db.Uuid
  vekaletnameNo     String? @map("vekaletname_no") @db.VarChar(40)
  vekaletBitisTarihi DateTime? @map("vekalet_bitis_tarihi") @db.Date

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  bolum  BagimsizBolum @relation(fields: [bolumId], references: [id])
  kisi   Kisi          @relation("MalikKisi", fields: [kisiId], references: [id])
  vekil  Kisi?         @relation("MalikVekil", fields: [vekilKisiId], references: [id])
  /// Bu malike DAYANARAK oturan sakinler (0021) — eşi, çocuğu, annesi…
  sakinler Sakin[]

  /// `id` zaten birincil anahtardır; bu tekillik BEDELSİZDİR ama `Sakin`in
  /// bileşik yabancı anahtarının hedefi olabilmesi için AÇIKÇA tanımlanmalıdır
  /// — dayanağın aynı bölümde olduğunu veritabanı böyle garanti eder.
  @@unique([id, bolumId], map: "malik_id_bolum_uq")
  @@index([tenantId, bolumId, tapuBaslangic])
  @@map("malik")
}

model Kiraci {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  bolumId  String @map("bolum_id") @db.Uuid
  kisiId   String @map("kisi_id") @db.Uuid

  baslangic DateTime  @db.Date
  bitis     DateTime? @db.Date

  sozlesmeNo       String?  @map("sozlesme_no") @db.VarChar(40)
  sozlesmeTarihi   DateTime? @map("sozlesme_tarihi") @db.Date
  /// Para: numeric(18,4) — ADR-0007 ölçeklenmiş bigint ile birebir örtüşür.
  depozito         Decimal? @db.Decimal(18, 4)
  depozitoIadeTarihi DateTime? @map("depozito_iade_tarihi") @db.Date

  /// --- Kefil (0012) ---
  ///
  /// KEFİL AYRI BİR `Kisi` KAYDI DEĞİLDİR. Yönetimin ortak gider alacağı
  /// malike (KMK md. 20) ve kiracıya (md. 22, kira bedeli kadar müteselsil)
  /// yönelir; KEFİLE YÖNELMEZ — kefalet, malik ile kiracı arasındaki kira
  /// sözleşmesinin tarafıdır. `Kisi` kaydı açılsaydı kefil malik/kiracı
  /// listelerine karışır ve borç sorumluluğu sorgularında görünürdü.
  kefilAdSoyad    String? @map("kefil_ad_soyad") @db.VarChar(120)
  kefilTcKimlikNo String? @map("kefil_tc_kimlik_no") @db.VarChar(11)
  kefilTelefon    String? @map("kefil_telefon") @db.VarChar(32)
  kefilAdres      String? @map("kefil_adres")

  tahliyeTarihi   DateTime? @map("tahliye_tarihi") @db.Date
  tahliyeGerekcesi String?  @map("tahliye_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  bolum  BagimsizBolum @relation(fields: [bolumId], references: [id])
  kisi   Kisi          @relation(fields: [kisiId], references: [id])
  /// Bu kiracıya DAYANARAK oturan sakinler (0021) — eşi, çocuğu, annesi…
  sakinler Sakin[]

  /// Bileşik yabancı anahtarın hedefi (bkz. `Malik` üzerindeki not).
  @@unique([id, bolumId], map: "kiraci_id_bolum_uq")
  @@index([tenantId, bolumId, baslangic])
  @@map("kiraci")
}

/// Sakinin, bağlı olduğu malik/kiracıya yakınlığı.
///
/// ⚠️  `ANNE_BABA` ESKİ değerdir ve KALDIRILMADI: enum değeri silmek, o değeri
///     taşıyan satırlar varsa imkânsızdır ve geçmiş kayıtların anlamı
///     değişmemelidir. Yeni kayıtlarda `ANNE` ya da `BABA` kullanılır — acil
///     durumda "annesini arayın" ile "babasını arayın" farklı bilgilerdir.
///
/// ⚠️  `KENDISI` KORUNDU. Kullanıcının istediği listede yoktur ama malikin ya
///     da kiracının KENDİ dairesinde oturması en yaygın durumdur; kaldırılsaydı
///     bu kişi "Diğer: kendisi" diye kaydedilmek zorunda kalırdı.
///
/// `AKRABA` · `MISAFIR` · `CALISAN` eski değerlerdir; yerlerini `DIGER` +
/// serbest metin aldı (Amcası · Bakıcısı · Refakatçisi…).
enum YakinlikDerecesi {
  KENDISI
  ES
  COCUK
  ANNE
  BABA
  ANNE_BABA
  KARDES
  AKRABA
  MISAFIR
  CALISAN
  DIGER
}

/// Fiilen oturan kişi. Kiracıdan AYRIDIR: malik oturabilir, kiracı oturmayıp
/// ailesi oturabilir, kiracı dışında sakinler bulunabilir.
model Sakin {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  bolumId  String @map("bolum_id") @db.Uuid
  kisiId   String @map("kisi_id") @db.Uuid

  /// SAKİN BİR DAYANAĞA BAĞLANIR: ya malike ya kiracıya, TAM OLARAK BİRİNE
  /// (veritabanı CHECK `sakin_dayanak_tek`). Bağ olmasaydı "bu kişi burada
  /// KİMİN YAKINI olarak oturuyor" sorusu yanıtsız kalırdı: kiracı
  /// taşındığında ailesinin akıbeti belirsiz olur, acil durumda çocuğun velisi
  /// bulunamazdı.
  malikId  String? @map("malik_id") @db.Uuid
  kiraciId String? @map("kiraci_id") @db.Uuid

  yakinlikDerecesi YakinlikDerecesi @default(KENDISI) @map("yakinlik_derecesi")
  /// `DIGER` seçildiğinde ZORUNLU serbest metin (Amcası · Bakıcısı ·
  /// Refakatçisi…). Sabit liste tek başına kullanılsaydı listede olmayan her
  /// ilişki "Diğer" olarak kaydedilir ve bilgi KAYBOLURDU.
  yakinlikAciklamasi String? @map("yakinlik_aciklamasi") @db.VarChar(80)

  girisTarihi      DateTime  @map("giris_tarihi") @db.Date
  cikisTarihi      DateTime? @map("cikis_tarihi") @db.Date

  acilDurumKisiAdi   String? @map("acil_durum_kisi_adi") @db.VarChar(120)
  acilDurumTelefon   String? @map("acil_durum_telefon") @db.VarChar(24)

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  bolum  BagimsizBolum @relation(fields: [bolumId], references: [id])
  kisi   Kisi          @relation(fields: [kisiId], references: [id])
  /// ⚠️  BİLEŞİK BAĞ — dayanak AYNI BÖLÜMDE olmak zorundadır. `bolumId` ikinci
  ///     anahtar olarak taşınır; böylece A dairesinin sakini B dairesinin
  ///     malikine BAĞLANAMAZ. Yalnızca serviste denetlenseydi, doğrudan
  ///     veritabanına yazan bir toplu aktarım kuralı sessizce atlardı.
  malik  Malik?  @relation(fields: [malikId, bolumId], references: [id, bolumId], onDelete: Restrict)
  kiraci Kiraci? @relation(fields: [kiraciId, bolumId], references: [id, bolumId], onDelete: Restrict)

  @@index([tenantId, bolumId, girisTarihi])
  @@index([tenantId, malikId])
  @@index([tenantId, kiraciId])
  @@map("sakin")
}

// ===========================================================================
// GİDER TÜRÜ — aidat kuralları VERİ'dir, koda gömülmez (ADR-0004 · ADR v1.1 §4)
// ===========================================================================

enum PaylasimKurali {
  ESIT
  ARSA_PAYI
  BRUT_M2
  NET_M2
  /// Geriye dönük uyumluluk — BRUT_M2 ile aynı davranır. Yeni tanımlarda
  /// hangi ölçünün kastedildiği açık yazılır (BFS v1 §11).
  METREKARE
  TUKETIM
  SABIT_TUTAR
  /// Yalnızca hizmeti KULLANAN bölümler öder — otopark, havuz, jeneratör.
  KULLANIM_BAZLI
  /// Yalnızca ilgili BLOĞUN bölümleri öder — o bloktaki asansör onarımı gibi.
  BLOK_BAZLI
  /// Yönetici tutarları bölüm bölüm belirler; toplam gidere eşit olmalıdır.
  MANUEL
  KARMA
}

enum SorumlulukTipi {
  MALIKE_AIT
  KULLANANA_AIT
  /// Fiilen oturana ait. Sakin yoksa kiracı, o da yoksa malik.
  ///
  /// KULLANANA_AIT'ten ayrıdır: kiracı bir şirket olabilir ve dairede
  /// şirketin çalışanı oturuyor olabilir. Su ya da ısınma gibi tüketime
  /// bağlı giderlerde yönetim planı sorumluluğu fiilen oturana verebilir.
  SAKINE_AIT
}

enum KuralKaynagi {
  KMK_VARSAYILAN
  YONETIM_PLANI
  GENEL_KURUL_KARARI
}

/// Tenant başına gider türü kataloğu. KMK varsayılanları tohumla yüklenir;
/// yönetim planı veya genel kurul kararı ile override edilir ve override
/// DAİMA kaynak referansı taşır — bir kuralın nereden geldiği kaybolmaz.
model GiderTuru {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  kod      String @db.VarChar(40)
  ad       String @db.VarChar(120)

  paylasimKurali PaylasimKurali @map("paylasim_kurali")
  sorumlulukTipi SorumlulukTipi @map("sorumluluk_tipi")
  kuralKaynagi   KuralKaynagi   @map("kural_kaynagi")
  kaynakReferansi String?       @map("kaynak_referansi") @db.VarChar(200)

  /// KARMA bileşenleri: [{ kural, yuzde }]. Toplam 100 olmak zorundadır;
  /// kısıt uygulama katmanında `giderTuruDogrula` ile zorlanır.
  karmaBilesenler Json? @map("karma_bilesenler")

  /// Bir bölümün borcunun malikler arasında nasıl bölüneceği.
  malikPaylasimi String @default("HISSE_ORANI") @map("malik_paylasimi") @db.VarChar(20)

  aktifMi Boolean @default(true) @map("aktif_mi")

  silindiMi      Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi  DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi String?   @map("silme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, kod])
  @@map("gider_turu")
}

// ===========================================================================
// MUHASEBE — çift taraflı defter (ADR-0003)
// FINANSAL sınıf: ASLA silinmez. Düzeltme ters kayıtla (storno).
// Para: numeric(18,4) — ADR-0007 ölçeklenmiş bigint ile birebir örtüşür.
// ===========================================================================

enum HesapTipi {
  VARLIK
  BORC
  OZKAYNAK
  GELIR
  GIDER
}

enum FisDurumu {
  TASLAK
  ISLENDI
  TERS_KAYITLI
}

///
/// Fiş türü (0015). Dönem kapanışı ve raporlar buna dayanır: kapanış fişi
/// gelir tablosuna girmez, açılış fişi dönem hareketi sayılmaz.
enum FisTuru {
  ACILIS
  MAHSUP
  TAHSILAT
  TEDIYE
  YANSITMA
  KAPANIS
}

///
/// Hesabın işlevsel özelliği (0015).
/// 
/// Kasa Defteri ve Banka Defteri hesabın KOD'una bakılarak üretilemez: kod
/// planı tenant'a göre değişir ('100' her tenant'ta kasa olmayabilir). Bu
/// ayrım VERİ olarak taşınır (§33 kural 3: politika koda gömülmez).
enum HesapOzelligi {
  NORMAL
  KASA
  BANKA
  YANSITMA
  /// Yardımcı defterin (bölüm cari bakiyeleri toplamı) mutabık olması gereken
  /// KONTROL HESABI — `120 Alıcılar` (ADR-0010). Kod ile DEĞİL bu alanla
  /// işaretlenir: hesap kodu tenant'a göre değişir ve '120' her tenant'ta
  /// alıcılar hesabı olmayabilir (§33 kural 3).
  CARI_KONTROL
}

enum DonemDurumu {
  ACIK
  KAPANIS_SURECI
  KAPALI
}

///
/// Muhasebe dönemi — mali yıl.
/// 
/// ⚠️  KAPALI DÖNEME FİŞ YAZILAMAZ. Muhasebenin en temel korumasıdır: kapanmış
///     bir mali yılın kaydı değişirse yayımlanmış bilanço ile defter tutmaz ve
///     denetim izi kopar. Düzeltme, kapalı döneme kayıt atarak DEĞİL açık
///     dönemde ters kayıt (storno) ile yapılır.
model MuhasebeDonemi {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Mali yıl. Türkiye'de takvim yılıyla aynıdır ama alan olarak tutulur:
  /// özel hesap dönemi (VUK md. 174) uygulayan tenant'ta farklı olabilir.
  maliYil   Int      @map("mali_yil")
  ad        String   @db.VarChar(60)
  baslangic DateTime @db.Date
  bitis     DateTime @db.Date
  durum     DonemDurumu @default(ACIK)

  /// Dönemin açılış ve kapanış fişleri. Kapanışta üretilir ve bir daha
  /// değişmez; hangi fişin dönemi kapattığı sorulduğunda cevap budur.
  acilisFisiId  String? @map("acilis_fisi_id") @db.Uuid
  kapanisFisiId String? @map("kapanis_fisi_id") @db.Uuid

  kapanisAni       DateTime? @map("kapanis_ani") @db.Timestamptz(6)
  kapatanKullanici String?   @map("kapatan_kullanici") @db.Uuid
  kapanisGerekcesi String?   @map("kapanis_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  fisler  YevmiyeFisi[]

  @@index([tenantId, durum])
  @@map("muhasebe_donemi")
}

///
/// Muhasebe parametreleri — tenant başına TEK satır.
/// 
/// Ayarların koda gömülmesi, iki tenant'ın farklı kasa hesabı kullanmasını
/// imkânsız kılardı (§33 kural 3).
model MuhasebeParametresi {
  tenantId String @id @map("tenant_id") @db.Uuid

  /// Varsayılan hesaplar. Boş bırakılabilir: kurulum tamamlanmadan tahsilat
  /// fişi kesilmesi engellenmeli ama parametre kaydı yine açılabilmeli.
  varsayilanKasaHesapId  String? @map("varsayilan_kasa_hesap_id") @db.Uuid
  varsayilanBankaHesapId String? @map("varsayilan_banka_hesap_id") @db.Uuid
  /// Dönem kapanışında kâr/zararın aktarıldığı özkaynak hesabı.
  donemKariHesapId       String? @map("donem_kari_hesap_id") @db.Uuid

  /// Yevmiye defteri yeniden numaralandırılırken kullanılan başlangıç.
  yevmiyeBaslangicNo Int @default(1) @map("yevmiye_baslangic_no")

  /// TASLAK fiş deftere GİRMEZ. Varsayılan `false`: işlenmemiş bir kayıt mali
  /// tabloya giremez.
  taslakMizanaGirer Boolean @default(false) @map("taslak_mizana_girer")

  /// Geriye dönük kayıt penceresi (gün). 0 = sınırsız. Kapalı dönem yasağı
  /// bundan BAĞIMSIZDIR ve her zaman geçerlidir.
  geriyeDonukGun Int @default(0) @map("geriye_donuk_gun")

  guncellemeTarihi DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant             Tenant  @relation(fields: [tenantId], references: [id])
  varsayilanKasa     Hesap?  @relation("ParamKasa", fields: [varsayilanKasaHesapId], references: [id], onDelete: Restrict)
  varsayilanBanka    Hesap?  @relation("ParamBanka", fields: [varsayilanBankaHesapId], references: [id], onDelete: Restrict)
  donemKariHesabi    Hesap?  @relation("ParamDonemKari", fields: [donemKariHesapId], references: [id], onDelete: Restrict)

  @@map("muhasebe_parametresi")
}

model Hesap {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  kod       String    @db.VarChar(20)
  ad        String    @db.VarChar(120)
  tip       HesapTipi
  ustHesapId String?  @map("ust_hesap_id") @db.Uuid
  fisKesilebilirMi Boolean @default(true) @map("fis_kesilebilir_mi")
  aktif     Boolean   @default(true)
  /// İşlevsel özellik (0015) — Kasa/Banka Defteri buna dayanır, koda değil.
  ozellik   HesapOzelligi @default(NORMAL)

  silindiMi      Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi  DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi String?   @map("silme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  ustHesap  Hesap?         @relation("HesapAgaci", fields: [ustHesapId], references: [id])
  altHesaplar Hesap[]      @relation("HesapAgaci")
  satirlar  YevmiyeSatiri[]

  paramKasa      MuhasebeParametresi[] @relation("ParamKasa")
  paramBanka     MuhasebeParametresi[] @relation("ParamBanka")
  paramDonemKari MuhasebeParametresi[] @relation("ParamDonemKari")

  // --- Banka çekirdeği (0016) ---
  /// Bu muhasebe hesabını KARŞILIK olarak kullanan banka hesapları.
  bankaHesaplari      BankaHesabi[]
  bankaParamMasraf    BankaParametresi[] @relation("BankaParamMasraf")
  bankaParamKomisyon  BankaParametresi[] @relation("BankaParamKomisyon")

  @@index([tenantId, kod])
  @@index([tenantId, ozellik])
  @@map("hesap")
}

model YevmiyeFisi {
  id       String    @id @db.Uuid
  tenantId String    @map("tenant_id") @db.Uuid
  fisNo    String    @map("fis_no") @db.VarChar(32)
  /// BFS v1 §4.1 — muhasebe tarihi takvim tarihidir.
  tarih    DateTime  @db.Date
  aciklama String
  kaynakTipi String  @map("kaynak_tipi") @db.VarChar(40)
  kaynakId   String? @map("kaynak_id") @db.Uuid
  durum    FisDurumu @default(TASLAK)
  /// Ters kayıt (storno) referansı — silme YOKTUR (BFS v1 §5.1).
  tersKaydiOlanId String? @map("ters_kaydi_olan_id") @db.Uuid

  /// --- 0015 ---
  fisTuru FisTuru @default(MAHSUP) @map("fis_turu")
  donemId String? @map("donem_id") @db.Uuid

  /// ⚠️  FİŞ NO ile YEVMİYE SIRA NO AYNI ŞEY DEĞİLDİR:
  ///   · `fisNo`         — kayıt anında verilen, boşluksuz seri.
  ///   · `yevmiyeSiraNo` — yevmiye defterine BASILDIĞINDA verilen sıra; dönem
  ///                       içinde TARİH SIRASINA göre yeniden numaralandırılır
  ///                       (VUK md. 183).
  /// Tek alanda tutulsaydı yeniden numaralandırma kayıt kimliğini de değiştirir
  /// ve makbuz üzerindeki numara ile defter tutmaz hale gelirdi.
  yevmiyeSiraNo Int? @map("yevmiye_sira_no")

  islenmeAni   DateTime? @map("islenme_ani") @db.Timestamptz(6)
  isleyenKisi  String?   @map("isleyen_kisi") @db.Uuid
  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  satirlar YevmiyeSatiri[]
  donem    MuhasebeDonemi? @relation(fields: [donemId], references: [id], onDelete: Restrict)
  /// Bu fişin dayandığı banka hareketleri (0016). Fişe bağlanan hareket bir
  /// daha DEĞİŞTİRİLEMEZ: mali kaydın dayanağı olmuştur.
  bankaHareketleri BankaHareketi[]
  /// Bu fişin dayandığı tahsilatlar (0017).
  tahsilatlar      Tahsilat[]

  @@index([tenantId, tarih])
  @@index([tenantId, donemId])
  @@index([tenantId, fisTuru])
  @@map("yevmiye_fisi")
}

model YevmiyeSatiri {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  fisId    String  @map("fis_id") @db.Uuid
  hesapId  String  @map("hesap_id") @db.Uuid
  /// ADR-0007 — numeric(18,4), asla float. Bir satırda borç VEYA alacak dolu olur.
  borc     Decimal @default(0) @db.Decimal(18, 4)
  alacak   Decimal @default(0) @db.Decimal(18, 4)
  aciklama String?
  bolumId  String? @map("bolum_id") @db.Uuid

  fis   YevmiyeFisi @relation(fields: [fisId], references: [id], onDelete: Cascade)
  hesap Hesap       @relation(fields: [hesapId], references: [id])

  @@index([tenantId, hesapId])
  @@map("yevmiye_satiri")
}

// ===========================================================================
// BORÇ — bağımsız bölüme bağlanır, kişiye değil (ADR v1.1 §5)
// Sorumlular SNAPSHOT olarak yazılır; sorgu anında hesaplanmaz.
// ===========================================================================

enum SorumlulukSirasi {
  ASIL
  IKINCIL
}

model Borc {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  bolumId  String @map("bolum_id") @db.Uuid
  giderTuruKodu String @map("gider_turu_kodu") @db.VarChar(40)
  tahakkukNo    String @map("tahakkuk_no") @db.VarChar(32)

  tutar    Decimal @db.Decimal(18, 4)
  odenen   Decimal @default(0) @db.Decimal(18, 4)
  /// BFS v1 §4.1 — VADE TARİHİ DATE'tir. timestamptz olsaydı saat dilimi
  /// sınırında bir gün kayar ve her borçlunun faizi yanlış hesaplanırdı.
  vadeTarihi     DateTime @map("vade_tarihi") @db.Date
  tahakkukDonemi DateTime @map("tahakkuk_donemi") @db.Date

  kapandiMi Boolean @default(false) @map("kapandi_mi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  bolum     BagimsizBolum   @relation(fields: [bolumId], references: [id])
  sorumlular BorcSorumlusu[]
  /// ⚠️  `odenen` ARTIK BU SATIRLARDAN TÜRETİLİR (0017 · ADR-0010), elle
  ///     yazılmaz. İki kaynak (kolon + tahsis satırları) bağımsız
  ///     yazılabilseydi biri güncellenmeyi unuttuğunda bakiye SESSİZCE yanlış
  ///     çıkardı — ve `odenen` kolonu ödeme kaydı olmadan da doğru görünür.
  tahsisler TahsilatTahsisi[]

  @@index([tenantId, bolumId, kapandiMi])
  @@index([tenantId, vadeTarihi])
  @@map("borc")
}

model BorcSorumlusu {
  id       String           @id @db.Uuid
  tenantId String           @map("tenant_id") @db.Uuid
  borcId   String           @map("borc_id") @db.Uuid
  kisiId   String           @map("kisi_id") @db.Uuid
  sira     SorumlulukSirasi
  rol      IliskiRolu
  /// SNAPSHOT kanıtı — sorumluluk bu tarihte çözüldü ve DEĞİŞMEZ.
  cozumlemeTarihi DateTime @map("cozumleme_tarihi") @db.Date

  /// Bu kişiden istenen tutar. Hisseli mülkiyette borç maliklere BÖLÜNÜR;
  /// bir malik kendi payını ödediğinde diğerlerinin borcu açık kalmalıdır.
  /// Tek sorumlu varsa borcun tamamına eşittir.
  pay      Decimal @db.Decimal(18, 4)
  odenen   Decimal @default(0) @db.Decimal(18, 4)
  /// Dağıtımda kullanılan ağırlık — hisse oranı ya da manuel değer.
  agirlik  BigInt  @default(1)
  kapandiMi Boolean @default(false) @map("kapandi_mi")

  borc Borc @relation(fields: [borcId], references: [id])
  kisi Kisi @relation(fields: [kisiId], references: [id])
  /// Hisseli mülkiyette BU SORUMLUNUN payına sayılan tahsisler (0017). Tahsis
  /// yalnızca borca bağlansaydı, bir malikin ödemesi bütün hissedarların
  /// borcunu kapatmış görünürdü.
  tahsisler TahsilatTahsisi[]

  @@unique([borcId, kisiId, sira])
  @@index([tenantId, kisiId])
  @@map("borc_sorumlusu")
}

// ===========================================================================
// OPERASYONEL VARLIKLAR — araç
//
// Domain katmanı (`shared/apartman-domain/src/arac`) bu kuralları zaten
// taşıyordu; eksik olan kalıcılıktı.
// ===========================================================================

enum AracTuru {
  OTOMOBIL
  MOTOSIKLET
  TICARI
  BISIKLET
  DIGER
}

/// Bölüme kayıtlı araç. Sahibi malik, kiracı veya sakin olabilir.
///
/// DÖNEMSELDİR: kayıt silinmez, `bitis` ile kapanır. Otopark gideri
/// KULLANIM_BAZLI dağıtıldığında hangi ayda hangi aracın kayıtlı olduğu
/// geriye dönük olarak bilinmek zorundadır.
model Arac {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// KAPSAM (`arac_kapsam` kısıtı):
  ///   · Malik · kiracı · sakin · daire görevlisi · misafir aracı → BÖLÜME
  ///     kayıtlıdır, bu alan doludur.
  ///   · Site personeli aracı → **YÖNETİME** kayıtlıdır, bu alan BOŞTUR.
  ///
  /// Personel aracını bir daireye yazmak, o dairenin otopark hakkını tüketmiş
  /// gösterir ve KULLANIM_BAZLI dağıtımda ona fazla pay çıkarır.
  bolumId  String? @map("bolum_id") @db.Uuid

  /// SAHİP — tam olarak BİRİ dolu olmak zorundadır (`arac_tek_sahip`).
  ///
  /// Otopark kapasitesi malik aracıyla bakıcının ya da güvenlik görevlisinin
  /// aracını AYIRT ETMEZ: hepsi yer kaplar. Bu yüzden ayrı tablolar yerine
  /// tek plaka kütüğü kullanılır ve sahip alanı dörde açılır.
  kisiId     String? @map("kisi_id") @db.Uuid
  gorevliId  String? @map("gorevli_id") @db.Uuid
  personelId String? @map("personel_id") @db.Uuid
  misafirId  String? @map("misafir_id") @db.Uuid

  /// Normalize edilmiş plaka (boşluksuz, büyük harf) — mükerrer denetimi
  /// bu değer üzerinden yapılır.
  plaka String   @db.VarChar(16)
  tur   AracTuru @default(OTOMOBIL)
  marka String?  @db.VarChar(40)
  model String?  @db.VarChar(40)
  renk  String?  @db.VarChar(24)

  /// Tahsisli otopark yeri etiketi. Boşsa araç kayıtlı ama yer tahsisli değil.
  otoparkYeri String? @map("otopark_yeri") @db.VarChar(24)

  baslangic DateTime  @db.Date
  bitis     DateTime? @db.Date

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  bolum    BagimsizBolum?  @relation(fields: [bolumId], references: [id], onDelete: Restrict)

  /// ⚠️  `onDelete: Restrict` ZORUNLUDUR, tercih değildir. Prisma isteğe bağlı
  ///     ilişkide `SetNull` varsayar; o durumda sahibi silinen araç satırının
  ///     sahip alanı boşalır ve `arac_tek_sahip` kısıtı (tam olarak bir sahip)
  ///     silme anında ihlal edilir. Sahibi silinmek istenen aracın önce
  ///     kapatılması gerekir.
  kisi     Kisi?           @relation(fields: [kisiId], references: [id], onDelete: Restrict)
  gorevli  DaireGorevlisi? @relation(fields: [gorevliId], references: [id], onDelete: Restrict)
  personel SitePersoneli?  @relation(fields: [personelId], references: [id], onDelete: Restrict)
  misafir  Misafir?        @relation(fields: [misafirId], references: [id], onDelete: Restrict)

  @@index([tenantId, bolumId])
  @@index([tenantId, plaka])
  @@index([tenantId, gorevliId])
  @@index([tenantId, personelId])
  @@index([tenantId, misafirId])
  @@map("arac")
}

enum SayacTuru {
  SU
  SICAK_SU
  ELEKTRIK
  DOGALGAZ
  /// Isı pay ölçer — radyatöre takılır, orantılı tüketim gösterir.
  ISI_PAY_OLCER
  /// Kalorimetre — doğrudan enerji ölçer (kWh/kcal).
  KALORIMETRE
}

/// Bağımsız bölüme takılı sayaç.
///
/// DEĞERLER TAM SAYIDIR, ondalık değil: 12,345 m³ → `deger = 12345`,
/// `olcekBasamak = 3`. Float kullanılsaydı yüz dairelik bir binada yuvarlama
/// farkları birikip toplam tüketimden sapardı (ADR-0007).
///
/// SİLİNMEZ: sökülen sayaç `sokulmeTarihi` ile kapanır. Geçmiş dönemin
/// TUKETIM dağıtımı bu sayacın okumalarına dayanır; kayıt kaybolursa
/// dağıtımın dayanağı okunamaz hale gelir.
model Sayac {
  id       String    @id @db.Uuid
  tenantId String    @map("tenant_id") @db.Uuid
  bolumId  String    @map("bolum_id") @db.Uuid
  tur      SayacTuru
  seriNo   String    @map("seri_no") @db.VarChar(40)

  /// Göstergenin basamak sayısı. Mekanik sayaç bu basamağı doldurunca başa
  /// döner (99999 → 00001); devir hesabı bu değere dayanır.
  basamak      Int
  /// Okumadaki ondalık basamak sayısı.
  olcekBasamak Int @default(0) @map("olcek_basamak")

  takilmaTarihi DateTime  @map("takilma_tarihi") @db.Date
  sokulmeTarihi DateTime? @map("sokulme_tarihi") @db.Date
  /// Takıldığı andaki gösterge değeri. Kullanılmış sayaçta sıfır olmaz.
  ilkDeger      BigInt    @default(0) @map("ilk_deger")

  /// Bu sayaç hangi sayacın yerine takıldı. Değişim dönemi tüketimi İKİ
  /// parçadan oluşur ve zincir olmadan eski sayacın son günleri sessizce
  /// kaybolur.
  oncekiSayacId String? @map("onceki_sayac_id") @db.Uuid

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  bolum        BagimsizBolum @relation(fields: [bolumId], references: [id])
  oncekiSayac  Sayac?        @relation("SayacZinciri", fields: [oncekiSayacId], references: [id])
  sonrakiSayac Sayac[]       @relation("SayacZinciri")
  okumalar     SayacOkumasi[]

  @@index([tenantId, bolumId, tur])
  @@map("sayac")
}

/// Sayaç okuması ve o okumayla oluşan tüketim.
///
/// TÜKETİM SAKLANIR, sorgu anında yeniden hesaplanmaz. Bu bir SNAPSHOT'tır:
/// bir okuma sonradan düzeltilirse geçmiş dönemlerin dağıtımı kendiliğinden
/// değişmemelidir — tahsil edilmiş aidatla tutmaz.
model SayacOkumasi {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  sayacId  String @map("sayac_id") @db.Uuid

  tarih  DateTime @db.Date
  deger  BigInt
  /// Gösterge başa döndü mü — OPERATÖR ONAYIYLA gelir, tahmin edilmez.
  devirMi Boolean @default(false) @map("devir_mi")

  /// Bir önceki okumaya göre hesaplanan tüketim. `tuketimHesapla` çıktısıdır.
  tuketim BigInt

  /// Okumanın kaynağı — elle mi girildi, uzaktan mı okundu.
  kaynak String @default("ELLE") @db.VarChar(16)
  notu   String?

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  sayac  Sayac  @relation(fields: [sayacId], references: [id])

  @@index([tenantId, sayacId, tarih])
  @@map("sayac_okumasi")
}

// ===========================================================================
// BELGE — versiyonlanır, SİLİNMEZ (BFS v1 §5.3 kural 3)
// ===========================================================================

enum BelgeTipi {
  YONETIM_PLANI
  GENEL_KURUL_KARARI
  TAPU
  KIRA_SOZLESMESI
  FATURA
  MAKBUZ
  SIGORTA_POLICESI
  RUHSAT
  TEKNIK_RAPOR
  YAZISMA
  DIGER
}

/// Belgenin bağlanabileceği varlık türleri.
///
/// MALIK · KIRACI · SAKIN, KISI'den AYRIDIR ve bilinçlidir: bir kira
/// sözleşmesi kişiye değil, o kişinin O BÖLÜMDEKİ kiracılık dönemine aittir.
/// Kişi başka bir daireye taşındığında eski sözleşme eski döneme bağlı kalır.
enum BelgeVarlikTipi {
  TENANT
  APARTMAN
  BLOK
  KAT
  BOLUM
  KISI
  MALIK
  KIRACI
  SAKIN
}

/// Belge kategorisi — türün üstünde, dosyalama düzeyi.
///
/// Kategori TÜRÜN özelliğidir, belgenin değil: "Fatura" her zaman MALI'dir.
/// Belge başına serbest bırakılsaydı aynı tür farklı kategorilere düşer ve
/// kategori bazlı arama güvenilmez olurdu.
enum BelgeKategorisi {
  /// Yönetim planı, genel kurul kararı, tapu, sözleşme.
  HUKUKI
  /// Fatura, makbuz, bütçe, denetim raporu.
  MALI
  /// Ruhsat, proje, teknik rapor, bakım kaydı.
  TEKNIK
  /// Yazışma, tutanak, duyuru.
  KURUMSAL
  /// Kimlik, ikametgâh — KVKK kapsamında özel dikkat gerektirir.
  KISISEL
}

/// Gizlilik seviyesi — KVKK veri minimizasyonu (md. 4/1-ç).
///
/// Bir kiracının kimlik fotokopisi bütün yönetim kuruluna açık olmamalıdır.
/// Seviye, İZİN kontrolünün ÜSTÜNE biner: izni olan bile kapsam dışındaki
/// KISIYE_OZEL belgeyi göremez.
enum BelgeGizliligi {
  /// Tüm sakinler görebilir (yönetim planı, genel kurul kararı).
  GENEL
  /// Yalnızca yönetim yetkisi olanlar.
  YONETIM
  /// Yalnızca belgenin ilgilisi ve yönetim.
  KISIYE_OZEL
}

/// Belge tipi saklama politikası — VERİ olarak, koda gömülmez.
///
/// Saklama süresi mevzuata ve yönetim kararına bağlıdır; ikisi de değişir.
/// Tenant başına tutulur: bir yönetim şirketi kendi arşiv politikasını
/// uygulayabilir.
model BelgeTipiPolitikasi {
  id       String    @id @db.Uuid
  tenantId String    @map("tenant_id") @db.Uuid
  tip      BelgeTipi

  /// Türün kategorisi — dosyalama düzeyi. Belge başına DEĞİL tür başına
  /// tanımlıdır: aynı tür farklı kategorilere düşerse arama güvenilmez olur.
  kategori BelgeKategorisi @default(KURUMSAL)

  /// Bu türdeki belgelerin VARSAYILAN gizlilik seviyesi. Belge kaydında
  /// yükseltilebilir, DÜŞÜRÜLEMEZ — kimlik fotokopisi yanlışlıkla herkese
  /// açılamamalıdır.
  varsayilanGizlilik BelgeGizliligi @default(YONETIM) @map("varsayilan_gizlilik")

  /// Yıl cinsinden asgari saklama süresi. `null` ise SÜRESİZ saklanır.
  saklamaYili Int? @map("saklama_yili")
  /// FİNANSAL sınıf — asla silinmez, yalnızca versiyonlanır (BFS v1 §5.1).
  finansalMi  Boolean @default(false) @map("finansal_mi")
  kaynakReferansi String? @map("kaynak_referansi") @db.VarChar(200)

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, tip])
  @@map("belge_tipi_politikasi")
}

/// Belge kaydı. Dosyanın kendisi nesne deposundadır (MinIO/S3);
/// burada YALNIZCA üstveri ve nesne anahtarı tutulur.
///
/// SİLİNMEZ, VERSİYONLANIR. Yeni sürüm eskisini geçersiz kılar ama yok
/// etmez: "hangi yönetim planına göre karar verildi?" sorusunun cevabı eski
/// sürümdedir.
model Belge {
  id       String          @id @db.Uuid
  tenantId String          @map("tenant_id") @db.Uuid
  tip      BelgeTipi
  /// BİRİNCİL kapsam — belgenin "sahibi". Ek bağlantılar `iliskiler`dedir.
  kapsam   BelgeVarlikTipi
  /// Kapsamın işaret ettiği kaydın kimliği. TENANT kapsamında `null`.
  ///
  /// TİPLİ YABANCI ANAHTAR YOK: hedef dokuz ayrı tabloya işaret edebilir.
  /// Varlığı uygulama katmanında denetlenir (`hedefiDogrula`).
  hedefId  String?         @map("hedef_id") @db.Uuid

  /// Gizlilik — türün varsayılanından YÜKSELTİLEBİLİR, düşürülemez.
  gizlilik BelgeGizliligi @default(YONETIM)

  /// Serbest not. Aramaya dahildir.
  notlar String?

  ad     String @db.VarChar(200)
  /// Aynı belgenin kaçıncı sürümü. 1'den başlar.
  surum  Int    @default(1)
  /// Bu sürümün geçersiz kıldığı önceki sürüm. İlk sürümde `null`.
  oncekiSurumId String? @map("onceki_surum_id") @db.Uuid

  belgeTarihi      DateTime  @map("belge_tarihi") @db.Date
  /// Geçerlilik bitişi — poliçe, ruhsat gibi belgelerde anlamlıdır.
  gecerlilikBitisi DateTime? @map("gecerlilik_bitisi") @db.Date

  /// Nesne deposundaki anahtar. Tenant kimliğiyle önekli — bir tenant'ın
  /// anahtarı diğerininkini tahmin etmeye yaramaz.
  dosyaAnahtari String @map("dosya_anahtari") @db.VarChar(300)
  dosyaBoyutu   Int    @map("dosya_boyutu")
  icerikTipi    String @map("icerik_tipi") @db.VarChar(120)
  /// Dosyanın SHA-256 özeti — nesne deposundaki içeriğin değişmediğini
  /// kanıtlar. Belge bir delildir; içeriği sessizce değişmemelidir.
  dosyaOzeti    String? @map("dosya_ozeti") @db.VarChar(64)

  /// Yeni sürüm yayınlandığında eskisi arşivlenir; SİLİNMEZ.
  arsivMi Boolean @default(false) @map("arsiv_mi")

  yukleyenKullanici String? @map("yukleyen_kullanici") @db.Uuid

  /// Saklama süresi dolmuş ve arşivdeki BELGE DIŞI kayıtlar silinebilir;
  /// finansal belgeler asla. Silme yine soft delete'tir.
  silindiMi      Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi  DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi String?   @map("silme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  /// KVKK kalıcı silme kaydı. Nesne deposundaki dosya SİLİNDİĞİNDE dolar;
  /// üstveri satırı kanıt olarak KALIR ("bu belge şu tarihte imha edildi").
  dosyaImhaTarihi DateTime? @map("dosya_imha_tarihi") @db.Timestamptz(6)

  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  oncekiSurum   Belge?           @relation("BelgeSurumu", fields: [oncekiSurumId], references: [id])
  sonrakiSurum  Belge[]          @relation("BelgeSurumu")
  iliskiler     BelgeIliskisi[]
  etiketler     BelgeEtiketi[]

  @@index([tenantId, kapsam, hedefId])
  @@index([tenantId, tip, arsivMi])
  @@map("belge")
}

/// Belge ↔ varlık bağlantısı. Bir belge BİRDEN ÇOK kayda bağlanabilir.
///
/// Örnek: kira sözleşmesinin sahibi BÖLÜM'dür ama KİRACI ve MALİK ile de
/// ilişkilidir. Tek alanla ifade edilseydi "bu kişinin belgeleri" sorgusu
/// yapılamaz, belge yalnızca daire üzerinden bulunabilirdi.
///
/// BİRİNCİL ilişki `belge.kapsam`/`hedefId` ile AYNIDIR ve aynı işlemde
/// buraya da yazılır; böylece sorgular tek tablodan çalışır ve iki kaynak
/// arasında ayrışma olmaz.
model BelgeIliskisi {
  id       String          @id @db.Uuid
  tenantId String          @map("tenant_id") @db.Uuid
  belgeId  String          @map("belge_id") @db.Uuid
  varlikTipi BelgeVarlikTipi @map("varlik_tipi")
  /// TENANT tipinde `null`.
  varlikId String?         @map("varlik_id") @db.Uuid
  /// Belgenin "sahibi" olan ilişki. Belge başına EN FAZLA BİR tane.
  birincilMi Boolean       @default(false) @map("birincil_mi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  belge  Belge  @relation(fields: [belgeId], references: [id], onDelete: Cascade)

  @@index([tenantId, varlikTipi, varlikId])
  @@index([tenantId, belgeId])
  @@map("belge_iliskisi")
}

/// Belge etiketi — serbest sınıflandırma.
///
/// Kategori ve tür KATALOGDUR, etiket serbesttir: "2026-genel-kurul",
/// "acil", "avukatta". Normalize edilerek (küçük harf, Türkçe duyarlı)
/// saklanır; "Acil" ve "acil" aynı etikettir.
model BelgeEtiketi {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  belgeId  String @map("belge_id") @db.Uuid
  etiket   String @db.VarChar(40)

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  belge  Belge  @relation(fields: [belgeId], references: [id], onDelete: Cascade)

  @@unique([belgeId, etiket])
  @@index([tenantId, etiket])
  @@map("belge_etiketi")
}

// ===========================================================================
// SİTE PERSONELİ — İŞVERENİ YÖNETİM OLAN kadro
//
// Site müdürü, yönetici, güvenlik, temizlik, teknik, bahçıvan, vale,
// resepsiyon, havuz görevlisi. Ücreti işletme projesinden ödenir, SGK'sı
// yönetim tarafından yapılır, vardiyası yönetim planlar, zimmeti yönetimin
// malıdır.
//
// ⚠️  DAİRE GÖREVLİSİ İLE KARIŞTIRILMAMALIDIR (aşağıda ayrı model). Daire
//     görevlisinin işvereni malik/kiracıdır; SGK · departman · vardiya ·
//     zimmet alanları orada yer almaz, çünkü bu yükümlülükler yönetimin
//     değildir.
//
// KİŞİ'DEN AYRI BİR TABLODUR ve bu bilinçlidir. `Kisi`, malik/kiracı/sakin
// ilişkilerinin dayandığı kimlik kaydıdır; personel ise bir İSTİHDAM
// kaydıdır ve kendi yaşam döngüsü vardır (işe giriş, vardiya, SGK, çıkış).
// Aynı tabloya sıkıştırılsaydı, bir kapıcının aynı zamanda o binada kiracı
// olması durumunda iki farklı kavram tek satıra binerdi.
// ===========================================================================

enum PersonelGorevi {
  SITE_MUDURU
  YONETICI
  GUVENLIK
  TEMIZLIK
  TEKNIK
  BAHCIVAN
  VALE
  RESEPSIYON
  HAVUZ_GOREVLISI
  DIGER
}

enum PersonelDurumu {
  AKTIF
  PASIF
}

enum Vardiya {
  GUNDUZ
  AKSAM
  GECE
  TAM_GUN
  DONUSUMLU
}

model SitePersoneli {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Çalıştığı yerleşke. Tek apartmanlı tenant'ta tek apartman olur;
  /// sitede personel belirli bir apartmana bağlı olabilir ya da site
  /// genelinde çalışır (`null`).
  apartmanId String? @map("apartman_id") @db.Uuid

  ad    String @db.VarChar(60)
  soyad String @db.VarChar(60)

  gorev      PersonelGorevi
  /// Serbest metin departman — "Teknik İşler", "Güvenlik Amirliği".
  departman  String? @db.VarChar(80)

  telefon String? @db.VarChar(32)
  eposta  String? @db.VarChar(180)

  /// KVKK: özel nitelikli olmayan ama kişisel veridir; anonimleştirmede
  /// geri döndürülemez şekilde temizlenir.
  tcKimlikNo String? @map("tc_kimlik_no") @db.VarChar(11)
  /// SGK sicil numarası. Bordro ve denetim için tutulur.
  sgkNo      String? @map("sgk_no") @db.VarChar(30)

  iseGirisTarihi     DateTime  @map("ise_giris_tarihi") @db.Date
  istenAyrilisTarihi DateTime? @map("isten_ayrilis_tarihi") @db.Date

  vardiya Vardiya        @default(GUNDUZ)
  durum   PersonelDurumu @default(AKTIF)

  notlar String?

  silindiMi      Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi  DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi String?   @map("silme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  /// `Restrict`: apartman silinirken personel kaydı sessizce "site geneli"ne
  /// dönüşmemeli — 0008'deki DDL de RESTRICT yazar.
  apartman     Apartman?             @relation(fields: [apartmanId], references: [id], onDelete: Restrict)
  sertifikalar PersonelSertifikasi[]
  zimmetler    PersonelZimmeti[]
  araclari     Arac[]

  @@index([tenantId, durum, gorev])
  @@index([tenantId, apartmanId])
  @@map("site_personeli")
}

/// Personel sertifikası — güvenlik görevlisi kimlik kartı, ilkyardım,
/// operatör belgesi gibi.
///
/// GEÇERLİLİK TARİHİ TAKİP EDİLİR: süresi dolmuş güvenlik sertifikasıyla
/// çalıştırmak idari yaptırım sebebidir ve bu ancak takip edilirse görülür.
model PersonelSertifikasi {
  id         String @id @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  personelId String @map("personel_id") @db.Uuid

  ad         String    @db.VarChar(120)
  kurum      String?   @db.VarChar(120)
  belgeNo    String?   @map("belge_no") @db.VarChar(60)
  verilisTarihi DateTime  @map("verilis_tarihi") @db.Date
  gecerlilikBitisi DateTime? @map("gecerlilik_bitisi") @db.Date

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  personel SitePersoneli @relation(fields: [personelId], references: [id], onDelete: Cascade)

  @@index([tenantId, personelId])
  @@map("personel_sertifikasi")
}

/// Personele zimmetlenen demirbaş — telsiz, anahtar, üniforma, araç.
///
/// YÖNETİMİN MALIDIR: bu yüzden yalnızca site personelinde vardır. Daire
/// görevlisine verilen anahtar malikin malıdır, yönetimin kütüğüne girmez.
///
/// İADE TARİHİ ile kapanır, SİLİNMEZ: işten ayrılan bir personelin üzerinde
/// kalan zimmet, ayrılıştan sonra sorulduğunda kayıtta görünmek zorundadır.
model PersonelZimmeti {
  id         String @id @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  personelId String @map("personel_id") @db.Uuid

  ad       String  @db.VarChar(120)
  seriNo   String? @map("seri_no") @db.VarChar(60)
  adet     Int     @default(1)

  zimmetTarihi DateTime  @map("zimmet_tarihi") @db.Date
  iadeTarihi   DateTime? @map("iade_tarihi") @db.Date
  notlar       String?

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  personel SitePersoneli @relation(fields: [personelId], references: [id], onDelete: Cascade)

  @@index([tenantId, personelId])
  @@map("personel_zimmeti")
}

// ===========================================================================
// DAİRE GÖREVLİSİ — İŞVERENİ MALİK / KİRACI / SAKİN olan kişi
//
// Çocuk bakıcısı, hasta bakıcısı, ev yardımcısı, temizlikçi, aşçı, şoför,
// özel güvenlik, özel öğretmen. Ücretini daire sahibi öder.
//
// YÖNETİM BU KİŞİNİN İŞVERENİ DEĞİLDİR. Kayıt, yönetimin **site giriş ve
// güvenlik kütüğü** olarak tuttuğu bilgidir. Bu yüzden:
//   · SGK · departman · vardiya · zimmet alanları YOKTUR — bunlar işverenin
//     yükümlülüğüdür ve burada tutulması yönetimi işveren gibi gösterirdi.
//   · `bolumId` ZORUNLUDUR — görevli daima tek bir bağımsız bölüme hizmet
//     eder; site personelindeki "site genelinde çalışır" hâli yoktur.
//   · KVKK veri sorumlusu, görevliyi çalıştıran maliktir; yönetim veri
//     işleyen konumundadır.
// ===========================================================================

enum DaireGorevi {
  COCUK_BAKICISI
  HASTA_BAKICISI
  YASLI_BAKICISI
  EV_YARDIMCISI
  TEMIZLIK
  ASCI
  SOFOR
  OZEL_GUVENLIK
  OZEL_OGRETMEN
  DIGER
}

enum DaireGorevlisiDurumu {
  AKTIF
  PASIF
}

/// Görevliyi kim çalıştırıyor. Yönetim İŞVEREN DEĞİLDİR; bu alan
/// sorumluluğun kimde olduğunu kayda geçirir (KVKK veri sorumlusu · SGK
/// yükümlüsü · site giriş iznini kim talep etti).
enum DaireGorevlisiIsvereni {
  MALIK
  KIRACI
  SAKIN
}

model DaireGorevlisi {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// Hizmet verdiği bağımsız bölüm. ZORUNLU.
  bolumId  String @map("bolum_id") @db.Uuid

  isvereniTipi DaireGorevlisiIsvereni @map("isveren_tipi")
  /// Hangi kişi çalıştırıyor. İSTEĞE BAĞLI: yönetim çoğu zaman yalnızca
  /// "daire 12'nin bakıcısı" bilgisine sahiptir; işveren kişiyi kayda
  /// geçirmek zorunlu tutulsaydı görevli hiç kaydedilemezdi.
  isverenKisiId String? @map("isveren_kisi_id") @db.Uuid

  ad    String @db.VarChar(60)
  soyad String @db.VarChar(60)

  /// KVKK: özel nitelikli olmayan ama kişisel veridir; anonimleştirmede
  /// geri döndürülemez şekilde temizlenir.
  tcKimlikNo  String?   @map("tc_kimlik_no") @db.VarChar(11)
  telefon     String?   @db.VarChar(32)
  eposta      String?   @db.VarChar(180)
  /// WhatsApp numarası — `telefon`dan ayrı tutulur (0019).
  whatsappNo  String?   @map("whatsapp_no") @db.VarChar(24)
  dogumTarihi DateTime? @map("dogum_tarihi") @db.Date
  cinsiyet    Cinsiyet  @default(BELIRTILMEMIS)
  adres       String?

  gorev            DaireGorevi
  calismaBaslangic DateTime  @map("calisma_baslangic") @db.Date
  calismaBitis     DateTime? @map("calisma_bitis") @db.Date
  aciklama         String?
  notlar           String?

  durum DaireGorevlisiDurumu @default(AKTIF)

  silindiMi      Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi  DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi String?   @map("silme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  bolum        BagimsizBolum @relation(fields: [bolumId], references: [id])
  /// `Restrict`: işveren kişi silinirken görevli kaydı işverensiz kalmamalı —
  /// sorumluluğun kimde olduğu bilgisi kaydın varlık sebebidir.
  isverenKisi  Kisi?         @relation("GorevliIsvereni", fields: [isverenKisiId], references: [id], onDelete: Restrict)
  araclari     Arac[]

  @@index([tenantId, bolumId, durum])
  @@index([tenantId, durum, gorev])
  @@index([tenantId, isverenKisiId])
  @@map("daire_gorevlisi")
}

/// Misafir — bağımsız bölümü ziyaret eden kişi.
///
/// HAK SAHİBİ DEĞİLDİR: borç sorumlusu olmaz, tahakkuka girmez, arsa payı
/// taşımaz. Bu yüzden `Kisi` kaydı açılmaz, bilgiler burada inline tutulur.
///
/// KVKK: misafir verisi doğası gereği KISA ÖMÜRLÜDÜR. Kalıcı bir kimlik
/// kaydı açmak, ziyaretten aylar sonra silinmesi gereken veriyi malik/kiracı
/// kayıtlarıyla aynı ömre bağlardı.
model Misafir {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// Ziyaret edilen bağımsız bölüm.
  bolumId  String @map("bolum_id") @db.Uuid

  ad    String @db.VarChar(60)
  soyad String @db.VarChar(60)

  tcKimlikNo  String?   @map("tc_kimlik_no") @db.VarChar(11)
  telefon     String?   @db.VarChar(32)
  eposta      String?   @db.VarChar(180)
  dogumTarihi DateTime? @map("dogum_tarihi") @db.Date
  cinsiyet    Cinsiyet  @default(BELIRTILMEMIS)
  adres       String?
  notlar      String?

  girisTarihi   DateTime  @map("giris_tarihi") @db.Date
  /// Boşsa misafir HÂLEN içeridedir; güvenlik/tahliye listesi bunu kullanır.
  cikisTarihi   DateTime? @map("cikis_tarihi") @db.Date
  ziyaretNedeni String?   @map("ziyaret_nedeni") @db.VarChar(200)

  silindiMi      Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi  DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi String?   @map("silme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  bolum    BagimsizBolum @relation(fields: [bolumId], references: [id])
  araclari Arac[]

  @@index([tenantId, bolumId, girisTarihi])
  @@index([tenantId, cikisTarihi])
  @@map("misafir")
}

// ===========================================================================
// ALTYAPI — Audit · Outbox · Numaralandırma · Zamanlayıcı
// Bunlar soft delete TAŞIMAZ; değiştirilemez veya operasyonel tablolardır.
// ===========================================================================

model AuditKaydi {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  principalId   String   @map("principal_id") @db.Uuid
  principalTipi String   @map("principal_tipi") @db.VarChar(16)
  eylem         String   @db.VarChar(24)
  varlik        String   @db.VarChar(60)
  varlikId      String   @map("varlik_id") @db.Uuid
  oncekiDeger   Json?    @map("onceki_deger")
  sonrakiDeger  Json?    @map("sonraki_deger")
  gerekce       String?
  correlationId String   @map("correlation_id") @db.Uuid
  ip            String?  @db.VarChar(45)
  kullaniciAjani String? @map("kullanici_ajani")
  olusmaAni     DateTime @map("olusma_ani") @db.Timestamptz(6)
  /// Hash zinciri — kaydın sonradan değiştirilmediğini kanıtlar.
  oncekiHash    String?  @map("onceki_hash") @db.VarChar(64)
  hash          String   @db.VarChar(64)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  /// Bu işlemin geri alınıp alınmadığı (0018). EN ÇOK BİR kayıt olabilir.
  /// İşaret audit satırının KENDİSİNE yazılamaz: audit UPDATE'i trigger ile
  /// reddedilir (hash zinciri kopmasın diye).
  geriAlma GeriAlma?

  @@index([tenantId, olusmaAni])
  @@index([tenantId, varlik, varlikId])
  @@map("audit_kaydi")
}

/// Geri alma yöntemi — denetimde "bu kayıt NASIL geri alındı" sorusunun cevabı.
enum GeriAlmaYontemi {
  /// Finansal kayıt: ters kayıt üretildi (fiş storno · makbuz iptali).
  TERS_KAYIT
  /// Soft-delete edilmiş kayıt geri yüklendi.
  GERI_YUKLE
  /// Oluşturma geri alındı: kayıt arşivlendi (soft delete).
  ARSIVLE
  /// Güncelleme geri alındı: alanlar `oncekiDeger`den yazıldı.
  ALAN_GERI_AL
}

/// GENEL GERİ AL (0018) — hangi denetim kaydının geri alındığı.
///
/// ⚠️  YENİ BİR "ne değişti" GÜNLÜĞÜ DEĞİLDİR. `audit_kaydi` zaten
///     `oncekiDeger`/`sonrakiDeger` tutuyor; ikinci bir günlük yazılsaydı iki
///     kaynak zamanla ayrışır ve geri alma YANLIŞ değere dönerdi. Bu tablo
///     yalnızca "geri alındı" olgusunu ve yöntemini taşır.
///
/// ⚠️  Kayıt DEĞİŞTİRİLEMEZ: `bnos_app` rolüne yalnızca SELECT ve INSERT
///     verildi. Geri alma olgusu da denetim izidir.
model GeriAlma {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Geri alınan denetim kaydı. TEKİLDİR: aynı işlem iki kez geri alınamaz.
  /// Alınabilseydi bir güncelleme iki kez "eski değere" döndürülür ve arada
  /// yapılan başka değişiklikler sessizce silinirdi.
  auditKaydiId String @unique @map("audit_kaydi_id") @db.Uuid

  varlik   String @db.VarChar(60)
  varlikId String @map("varlik_id") @db.Uuid
  eylem    String @db.VarChar(20)

  yontem GeriAlmaYontemi
  /// Ters kayıt üretildiyse doğan kaydın kimliği (storno fişi vb.).
  sonucVarlikId String? @map("sonuc_varlik_id") @db.Uuid

  geriAlan String  @map("geri_alan") @db.Uuid
  gerekce  String?

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  auditKaydi AuditKaydi @relation(fields: [auditKaydiId], references: [id], onDelete: Restrict)

  @@index([tenantId, geriAlan, olusturulmaTarihi])
  @@index([tenantId, varlik, varlikId])
  @@map("geri_alma")
}

model OutboxKayit {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(120)
  eventVersion  Int       @map("event_version")
  zarf          Json
  olusturulmaTarihi DateTime @map("olusturulma_tarihi") @db.Timestamptz(6)
  yayinlanmaTarihi  DateTime? @map("yayinlanma_tarihi") @db.Timestamptz(6)
  denemeSayisi  Int       @default(0) @map("deneme_sayisi")
  sonHata       String?   @map("son_hata")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([yayinlanmaTarihi])
  @@map("outbox_kayit")
}

model NumaraSayaci {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// core-domain SERI_KATALOGU kodu.
  seriKodu String @map("seri_kodu") @db.VarChar(40)
  /// Kapsam anahtarı: tenant / tenant+yıl / tenant+tip.
  kapsamAnahtari String @map("kapsam_anahtari") @db.VarChar(120)
  mevcutDeger    BigInt @default(0) @map("mevcut_deger")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, seriKodu, kapsamAnahtari])
  @@map("numara_sayaci")
}

enum IsDurumu {
  BEKLIYOR
  CALISIYOR
  BASARILI
  BASARISIZ
}

model IsCalistirma {
  id       String   @id @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  isKodu   String   @map("is_kodu") @db.VarChar(60)
  /// ADR v1.1 §36 kural 1 — dönem başına EN FAZLA BİR KEZ.
  donemAnahtari String @map("donem_anahtari") @db.VarChar(40)
  durum    IsDurumu @default(BEKLIYOR)
  baslangic DateTime? @db.Timestamptz(6)
  bitis     DateTime? @db.Timestamptz(6)
  sonuc     Json?
  hata      String?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  /// Zamanlayıcı iki kez tetiklense veya pod yeniden başlasa da bir kez çalışır.
  @@unique([isKodu, tenantId, donemAnahtari])
  @@map("is_calistirma")
}

// ===========================================================================
// BANKA YÖNETİMİ (0016)
//
// Kullanıcının istediği 17 alt modül DOKUZ MODELE indirildi. Bu bir eksiltme
// değil, tekrarın önlenmesidir:
//
//   Havale · EFT · FAST · Virman · Masraf · Faiz  →  BankaHareketi.islemTipi
//   POS Tanımları · Sanal POS                     →  PosTanimi.tip
//   Çek · Senet                                   →  KiymetliEvrak.tip
//   Ekstre · Online Ekstre · Mutabakat            →  BankaEkstresi + EkstreSatiri
//
// ⚠️  HAVALE ve EFT AYRI TABLO DEĞİLDİR. İkisi de "bir banka hesabından para
//     çıkışı"dır; alan kümeleri birebir aynıdır. Ayrı tutulsaydı banka
//     bakiyesi dört ayrı sorgunun toplamı olur ve biri unutulduğunda bakiye
//     SESSİZCE yanlış çıkardı.
// ===========================================================================

model Banka {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  ad       String @db.VarChar(120)

  /// TCMB EFT kodu (4 hane). IBAN'ın 5-8. haneleriyle eşleşir; mutabakatta
  /// hareketin hangi bankadan geldiğini bu kod söyler.
  eftKodu String? @map("eft_kodu") @db.VarChar(4)
  swift   String? @db.VarChar(11)

  silindiMi      Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi  DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi String?   @map("silme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  subeler  BankaSubesi[]
  hesaplar BankaHesabi[]
  evraklar KiymetliEvrak[]

  @@index([tenantId])
  @@map("banka")
}

model BankaSubesi {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  bankaId  String  @map("banka_id") @db.Uuid
  ad       String  @db.VarChar(120)
  subeKodu String? @map("sube_kodu") @db.VarChar(10)
  adres    String?
  telefon  String? @db.VarChar(32)

  silindiMi      Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi  DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi String?   @map("silme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  banka    Banka           @relation(fields: [bankaId], references: [id])
  hesaplar BankaHesabi[]
  evraklar KiymetliEvrak[]

  @@index([tenantId, bankaId])
  @@map("banka_subesi")
}

/// Banka hesabı.
///
/// ⚠️  MUHASEBE HESABINA BAĞLIDIR ve bu bağ ZORUNLUDUR. Bağ olmasaydı banka
///     bakiyesi ile 102 Bankalar hesabının bakiyesi birbirinden bağımsız iki
///     sayı olur ve MUTABAKAT YAPILAMAZDI. Bağlanan hesabın `ozellik = BANKA`
///     olması gerekir (0015) — bu kural serviste zorlanır.
model BankaHesabi {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  bankaId  String  @map("banka_id") @db.Uuid
  subeId   String? @map("sube_id") @db.Uuid

  /// Muhasebe karşılığı — ZORUNLU (üstteki not).
  muhasebeHesapId String @map("muhasebe_hesap_id") @db.Uuid

  ad         String  @db.VarChar(120)
  iban       String? @db.VarChar(34)
  hesapNo    String? @map("hesap_no") @db.VarChar(32)
  paraBirimi String  @default("TRY") @map("para_birimi") @db.Char(3)

  /// Hesabın banka nezdindeki açılış bakiyesi. Muhasebe açılış fişinden
  /// AYRIDIR: banka gerçeği ile defterin başlangıç noktası farklı olabilir ve
  /// fark mutabakatta görünmelidir.
  acilisBakiyesi Decimal   @default(0) @map("acilis_bakiyesi") @db.Decimal(18, 4)
  acilisTarihi   DateTime? @map("acilis_tarihi") @db.Date
  aktif          Boolean   @default(true)
  notlar         String?

  silindiMi      Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi  DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi String?   @map("silme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  banka          Banka        @relation(fields: [bankaId], references: [id])
  sube           BankaSubesi? @relation(fields: [subeId], references: [id], onDelete: Restrict)
  muhasebeHesabi Hesap        @relation(fields: [muhasebeHesapId], references: [id], onDelete: Restrict)

  posTanimlari    PosTanimi[]
  hareketler      BankaHareketi[]
  ekstreler       BankaEkstresi[]
  tahsilEvraklari KiymetliEvrak[]    @relation("EvrakTahsilHesabi")
  varsayilanOlanParametreler BankaParametresi[] @relation("BankaParamVarsayilan")

  @@index([tenantId, bankaId])
  @@index([tenantId, muhasebeHesapId])
  @@map("banka_hesabi")
}

/// Sanal POS'un fiziki POS'tan tek farkı `tip` alanıdır; alan kümesi (banka
/// hesabı · komisyon · valör · terminal no) aynıdır. Ayrı model yapılsaydı
/// komisyon hesabı iki yerde yazılır ve biri güncellenmeyi unuturdu.
enum PosTipi {
  FIZIKI
  SANAL
}

model PosTanimi {
  id            String  @id @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  bankaHesabiId String  @map("banka_hesabi_id") @db.Uuid
  tip           PosTipi @default(FIZIKI)
  ad            String  @db.VarChar(120)
  terminalNo    String? @map("terminal_no") @db.VarChar(32)
  uyeIsyeriNo   String? @map("uye_isyeri_no") @db.VarChar(32)

  /// Komisyon oranı BİNDE tam sayıdır: `25` = binde 25 = %2,5. Binde tutulur
  /// çünkü gerçek POS sözleşmeleri %1,79 gibi kesirli oranlar içerir; yüzde
  /// tam sayı olsaydı bunlar temsil edilemezdi. Ondalık `float` olsaydı her
  /// tahsilatta kuruş sapardı (ADR-0007 gerekçesi).
  komisyonBinde Int @default(0) @map("komisyon_binde")

  /// Valör: paranın hesaba geçtiği gün sayısı. 0 = aynı gün.
  valorGunu Int     @default(0) @map("valor_gunu")
  aktif     Boolean @default(true)

  silindiMi      Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi  DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi String?   @map("silme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  bankaHesabi BankaHesabi     @relation(fields: [bankaHesabiId], references: [id])
  hareketler  BankaHareketi[]

  @@index([tenantId, bankaHesabiId])
  @@map("pos_tanimi")
}

/// Banka hareket tipi. Havale · EFT · FAST · Virman · Masraf AYRI KAVRAM
/// DEĞİLDİR; hepsi bir banka hesabına para giriş/çıkışıdır.
enum BankaIslemTipi {
  HAVALE
  EFT
  FAST
  VIRMAN
  MASRAF
  FAIZ
  POS_TAHSILAT
  CEK_TAHSIL
  SENET_TAHSIL
  NAKIT
  DIGER
}

enum HareketYonu {
  GIRIS
  CIKIS
}

/// Banka hareketi — bankanın değil BİZİM kaydımız.
///
/// ⚠️  YÖN AYRI ALANDIR, tutar İŞARETSİZDİR. Negatif tutarla çıkış yazmak
///     mümkün olsaydı toplamlar işaret karışıklığıyla bozulur ve "toplam
///     giriş" sorgusu negatifleri de toplardı.
///
/// ⚠️  MUHASEBELEŞTİRME AYRI ADIMDIR (`yevmiyeFisiId`). Hareket banka
///     gerçeğidir ve fiş kesilmeden de var olabilir; fiş kesildikten sonra
///     hareket DEĞİŞTİRİLEMEZ (mali kaydın dayanağı olmuştur).
model BankaHareketi {
  id            String @id @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  bankaHesabiId String @map("banka_hesabi_id") @db.Uuid

  islemTipi BankaIslemTipi @map("islem_tipi")
  yon       HareketYonu
  /// İŞARETSİZ tutar; yön `yon` alanındadır (veritabanı CHECK ile zorlanır).
  tutar     Decimal        @db.Decimal(18, 4)

  /// İşlem tarihi ile VALÖR tarihi FARKLIDIR: POS tahsilatı bugün olur ama
  /// para üç gün sonra hesaba geçer. Bakiye valöre, ekstre işlem tarihine göre
  /// okunur; tek alan tutulsaydı ikisi de yanlış olurdu.
  islemTarihi DateTime  @map("islem_tarihi") @db.Date
  valorTarihi DateTime? @map("valor_tarihi") @db.Date

  aciklama   String
  karsiTaraf String? @map("karsi_taraf") @db.VarChar(200)
  karsiIban  String? @map("karsi_iban") @db.VarChar(34)
  /// Banka referans/dekont numarası — mutabakatın BİRİNCİL eşleştirme anahtarı.
  referansNo String? @map("referans_no") @db.VarChar(64)

  /// Virmanın karşı bacağı. Virman İKİ hareket üretir (çıkış + giriş) ve
  /// birbirlerine referans verir; tek kayıt olsaydı iki hesabın bakiyesi tek
  /// satırdan türetilmek zorunda kalırdı.
  karsiHareketId String? @map("karsi_hareket_id") @db.Uuid

  posTanimiId     String? @map("pos_tanimi_id") @db.Uuid
  kiymetliEvrakId String? @map("kiymetli_evrak_id") @db.Uuid

  /// Muhasebeleştirme. Boşsa hareket henüz deftere girmemiştir.
  yevmiyeFisiId String? @map("yevmiye_fisi_id") @db.Uuid

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  bankaHesabi   BankaHesabi     @relation(fields: [bankaHesabiId], references: [id])
  karsiHareket  BankaHareketi?  @relation("Virman", fields: [karsiHareketId], references: [id], onDelete: Restrict)
  karsisiOlan   BankaHareketi[] @relation("Virman")
  posTanimi     PosTanimi?      @relation(fields: [posTanimiId], references: [id], onDelete: Restrict)
  kiymetliEvrak KiymetliEvrak?  @relation(fields: [kiymetliEvrakId], references: [id], onDelete: Restrict)
  yevmiyeFisi   YevmiyeFisi?    @relation(fields: [yevmiyeFisiId], references: [id], onDelete: Restrict)
  /// Bu hareketle eşleşen ekstre satırı. En çok BİR tane olabilir; kısmî
  /// tekillik index'i (`ekstre_satiri_eslesen_hareket_uq`) bunu zorlar.
  eslesenSatirlar EkstreSatiri[]
  /// Bu banka hareketine karşılık gelen aidat tahsilatları (0017). Bu bağ
  /// olmadan banka mutabakatı tahsilatı göremez: para hesaba girer ama hangi
  /// borcu kapattığı kayıtsız kalır.
  tahsilatlar     Tahsilat[]

  @@index([tenantId, bankaHesabiId, islemTarihi])
  @@index([tenantId, referansNo])
  @@map("banka_hareketi")
}

enum EkstreKaynagi {
  ELLE
  DOSYA
  ONLINE
}

enum MutabakatDurumu {
  ESLESMEDI
  ESLESTI
  FARK_KABUL
}

/// Banka ekstresi — BANKANIN beyanı, bizim kaydımız değil.
///
/// İkisi ayrı tutulur ki FARK GÖRÜNÜR olsun: ekstrede olup sistemde olmayan
/// satır, kaçırılmış bir hareket demektir. Tek tabloda birleştirilseydi fark
/// diye bir şey kalmaz, mutabakat kavramı ortadan kalkardı.
model BankaEkstresi {
  id            String @id @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  bankaHesabiId String @map("banka_hesabi_id") @db.Uuid

  baslangic DateTime @db.Date
  bitis     DateTime @db.Date
  /// Bankanın BEYAN ETTİĞİ açılış/kapanış bakiyesi — kendi hesabımız değil.
  acilisBakiyesi  Decimal @map("acilis_bakiyesi") @db.Decimal(18, 4)
  kapanisBakiyesi Decimal @map("kapanis_bakiyesi") @db.Decimal(18, 4)

  kaynak          EkstreKaynagi @default(ELLE)
  /// Dosya/online kaynaklı ekstrede özgün dosya adı — denetim izi.
  kaynakReferansi String?       @map("kaynak_referansi") @db.VarChar(200)

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  bankaHesabi BankaHesabi    @relation(fields: [bankaHesabiId], references: [id])
  satirlar    EkstreSatiri[]

  @@index([tenantId, bankaHesabiId, baslangic])
  @@map("banka_ekstresi")
}

model EkstreSatiri {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  ekstreId String @map("ekstre_id") @db.Uuid

  islemTarihi DateTime    @map("islem_tarihi") @db.Date
  valorTarihi DateTime?   @map("valor_tarihi") @db.Date
  yon         HareketYonu
  tutar       Decimal     @db.Decimal(18, 4)
  aciklama    String
  referansNo  String?     @map("referans_no") @db.VarChar(64)
  /// Bankanın satır sonrası bakiyesi — sıralama ve tutarlılık denetimi.
  bakiye      Decimal?    @db.Decimal(18, 4)

  // --- MUTABAKAT ---
  mutabakatDurumu     MutabakatDurumu @default(ESLESMEDI) @map("mutabakat_durumu")
  eslesenHareketId    String?         @map("eslesen_hareket_id") @db.Uuid
  eslestirenKullanici String?         @map("eslestiren_kullanici") @db.Uuid
  eslesmeAni          DateTime?       @map("eslesme_ani") @db.Timestamptz(6)
  /// FARK_KABUL için gerekçe ZORUNLUDUR (veritabanı CHECK): bir farkı "kabul
  /// edildi" diye kapatmak, gerekçesi yazılmazsa denetimde açıklanamaz.
  farkGerekcesi       String?         @map("fark_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  ekstre         BankaEkstresi  @relation(fields: [ekstreId], references: [id], onDelete: Cascade)
  eslesenHareket BankaHareketi? @relation(fields: [eslesenHareketId], references: [id], onDelete: Restrict)

  @@index([tenantId, ekstreId])
  @@map("ekstre_satiri")
}

enum KiymetliEvrakTipi {
  CEK
  SENET
}

enum KiymetliEvrakDurumu {
  PORTFOYDE
  TAHSILDE
  TAHSIL_EDILDI
  KARSILIKSIZ
  CIRO_EDILDI
  IADE_EDILDI
}

/// Kıymetli evrak — Çek ve Senet AYNI MODEL, farkı `tip`.
///
/// Alan kümesi birebir aynıdır (vade · tutar · borçlu · durum). Ayrı model
/// yapılsaydı durum makinesi iki yerde yazılır ve biri güncellenmeyi unuturdu.
///
/// ⚠️  DURUM MAKİNESİ ATLAMA KABUL ETMEZ (domain'de zorlanır):
///       PORTFOYDE → TAHSILDE → TAHSIL_EDILDI
///                            → KARSILIKSIZ → TAHSILDE (yeniden ibraz)
///       PORTFOYDE → CIRO_EDILDI / IADE_EDILDI
///     Doğrudan TAHSIL_EDILDI'ye atlamak, çekin bankaya hiç verilmediği hâlde
///     tahsil edilmiş görünmesi demektir; "tahsilde bekleyenler" listesi bir
///     daha doğru olmazdı.
model KiymetliEvrak {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  tip   KiymetliEvrakTipi
  durum KiymetliEvrakDurumu @default(PORTFOYDE)

  evrakNo    String   @map("evrak_no") @db.VarChar(64)
  tutar      Decimal  @db.Decimal(18, 4)
  vadeTarihi DateTime @map("vade_tarihi") @db.Date
  alisTarihi DateTime @map("alis_tarihi") @db.Date

  /// Çeki/senedi VEREN taraf. Dışarıdan gelen çekin borçlusunun kişi kaydı
  /// olmayabilir; bu yüzden serbest metin ZORUNLU, kişi bağı isteğe bağlıdır.
  borcluAdi    String  @map("borclu_adi") @db.VarChar(200)
  borcluKisiId String? @map("borclu_kisi_id") @db.Uuid

  /// Çekte banka/şube bilgisi vardır, senette olmayabilir.
  bankaId String? @map("banka_id") @db.Uuid
  subeId  String? @map("sube_id") @db.Uuid

  /// Tahsile verildiği banka hesabı.
  tahsilHesabiId String?   @map("tahsil_hesabi_id") @db.Uuid
  tahsilTarihi   DateTime? @map("tahsil_tarihi") @db.Date
  /// Olumsuz durumlar (KARSILIKSIZ · IADE_EDILDI) için ZORUNLU: karşılıksız
  /// çıkan bir çekin neden öyle işaretlendiği sonradan sorulabilir olmalıdır.
  durumGerekcesi String?   @map("durum_gerekcesi")

  notlar String?

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  borcluKisi   Kisi?           @relation(fields: [borcluKisiId], references: [id], onDelete: Restrict)
  banka        Banka?          @relation(fields: [bankaId], references: [id], onDelete: Restrict)
  sube         BankaSubesi?    @relation(fields: [subeId], references: [id], onDelete: Restrict)
  tahsilHesabi BankaHesabi?    @relation("EvrakTahsilHesabi", fields: [tahsilHesabiId], references: [id], onDelete: Restrict)
  hareketler   BankaHareketi[]
  /// Bu çek/senet ile yapılan tahsilatlar (0017).
  tahsilatlar  Tahsilat[]

  @@index([tenantId, durum, vadeTarihi])
  @@map("kiymetli_evrak")
}

/// Banka parametreleri — tenant başına TEK satır.
///
/// Ayarların koda gömülmesi, iki tenant'ın farklı masraf hesabı kullanmasını
/// imkânsız kılardı (§33 kural 3: politika koda gömülmez, VERİ olarak taşınır).
model BankaParametresi {
  tenantId String @id @map("tenant_id") @db.Uuid

  varsayilanBankaHesabiId String? @map("varsayilan_banka_hesabi_id") @db.Uuid
  /// Banka masraflarının yazıldığı gider hesabı.
  masrafGiderHesapId      String? @map("masraf_gider_hesap_id") @db.Uuid
  /// POS komisyonunun yazıldığı gider hesabı.
  posKomisyonHesapId      String? @map("pos_komisyon_hesap_id") @db.Uuid

  /// Otomatik eşleştirmede kabul edilen tutar toleransı (kuruş). 0 = tam
  /// eşleşme zorunlu. Tolerans varsayılan olarak KAPALIDIR: makine kuruş
  /// farkını sessizce yutarsa gerçek bir eksik tahsilat mutabık görünür.
  mutabakatToleransKurus Int @default(0) @map("mutabakat_tolerans_kurus")
  /// Otomatik eşleştirmede tarih penceresi (gün) — valör gecikmesi payı.
  mutabakatGunPenceresi  Int @default(3) @map("mutabakat_gun_penceresi")

  guncellemeTarihi DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  varsayilanHesap BankaHesabi? @relation("BankaParamVarsayilan", fields: [varsayilanBankaHesabiId], references: [id], onDelete: Restrict)
  masrafHesabi    Hesap?       @relation("BankaParamMasraf", fields: [masrafGiderHesapId], references: [id], onDelete: Restrict)
  komisyonHesabi  Hesap?       @relation("BankaParamKomisyon", fields: [posKomisyonHesapId], references: [id], onDelete: Restrict)

  @@map("banka_parametresi")
}

// ===========================================================================
// TAHSİLAT ve CARİ YARDIMCI DEFTERİ (0017 · ADR-0010)
//
// Cari hesap AYRI BİR VARLIK DEĞİLDİR: kontrol hesabı `120 Alıcılar` ile
// mutabık olan BÖLÜM BAZLI yardımcı defterdir. Borç bölüme aittir (KMK md. 22),
// sorumlu kişi `borc_sorumlusu` üzerinde TARİHSEL snapshot olarak durur.
// Kişi ekstresi bir GÖRÜNÜMDÜR, ayrı defter değil.
//
// ⚠️  BU MIGRATION'A KADAR ÖDEME KAYDI HİÇ YOKTU. Ödeme yalnızca `borc.odenen`
//     kolonunda yürüyen bir toplamdı ve o kolon ödeme kaydı OLMADAN DA DOĞRU
//     GÖRÜNÜR — toplam tuttuğu için ödeme geçmişinin var olduğu sanılırdı.
//     Eksiklik ancak ekstre üretmeye çalışınca ortaya çıktı.
// ===========================================================================

/// Tahsilat kanalı. Her kanal farklı bir kanıt taşır: banka kanalı banka
/// hareketi, çek/senet kanalı kıymetli evrak ister (veritabanı CHECK).
enum TahsilatKanali {
  NAKIT
  BANKA
  POS
  CEK
  SENET
  /// Mahsup — para hareketi olmadan borcun kapatılması (alacakla takas).
  MAHSUP
}

enum TahsilatDurumu {
  GECERLI
  IPTAL
}

/// Tahsilat — FİNANSAL kayıt.
///
/// ⚠️  SOFT DELETE ALANLARI BİLİNÇLİ OLARAK YOK (BFS v1 §5.1). Hatalı tahsilat
///     `durum = IPTAL` ile gerekçelenir; kayıt defterde KALIR ve makbuz
///     numarası serisinde boşluk oluşmaz. VUK uyarınca makbuz numarası
///     atlamaz; iptal edilen makbuz da numarasını korur.
model Tahsilat {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// BOŞLUKSUZ seri (`NumaraServisi` · seri `MAKBUZ`). Tenant içinde tekildir:
  /// aynı numaralı iki makbuz, hangisinin geçerli olduğu sorulduğunda cevapsız
  /// kalır.
  makbuzNo String @map("makbuz_no") @db.VarChar(32)

  kanal TahsilatKanali
  durum TahsilatDurumu @default(GECERLI)

  /// İŞARETSİZ tutar. Tahsilat her zaman paranın GİRİŞİdir; iade ayrı bir
  /// kavramdır ve negatif tahsilat olarak yazılmaz (toplamları bozar).
  tutar           Decimal  @db.Decimal(18, 4)
  tahsilatTarihi  DateTime @map("tahsilat_tarihi") @db.Date

  aciklama String?

  /// ÖDEYEN kişi, BORÇLU ile aynı olmak zorunda DEĞİLDİR: komşusu ya da
  /// akrabası adına ödeme yapılabilir. Borçlu kimliği tahsis satırındaki
  /// `borcSorumlusuId` üzerinden gelir.
  odeyenKisiId String? @map("odeyen_kisi_id") @db.Uuid
  tahsilEden   String? @map("tahsil_eden") @db.Uuid

  /// 0016 BAĞLARI. Banka kanalıyla gelen tahsilatın hangi banka hareketine
  /// karşılık geldiği; çek/senet ile ödemede hangi evrak. Bu bağ olmadan banka
  /// mutabakatı aidat tahsilatını göremez.
  bankaHareketiId String? @map("banka_hareketi_id") @db.Uuid
  kiymetliEvrakId String? @map("kiymetli_evrak_id") @db.Uuid

  /// Muhasebeleştirme. Boşsa tahsilat henüz deftere girmemiştir.
  yevmiyeFisiId String? @map("yevmiye_fisi_id") @db.Uuid

  /// İPTAL — gerekçe ZORUNLU (veritabanı CHECK). Bir tahsilatı iptal etmek
  /// parayı geri vermek değildir; hangi kararla iptal edildiği denetimde
  /// sorulabilir olmalıdır.
  iptalGerekcesi String?   @map("iptal_gerekcesi")
  iptalEden      String?   @map("iptal_eden") @db.Uuid
  iptalAni       DateTime? @map("iptal_ani") @db.Timestamptz(6)

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  odeyenKisi    Kisi?          @relation(fields: [odeyenKisiId], references: [id], onDelete: Restrict)
  bankaHareketi BankaHareketi? @relation(fields: [bankaHareketiId], references: [id], onDelete: Restrict)
  kiymetliEvrak KiymetliEvrak? @relation(fields: [kiymetliEvrakId], references: [id], onDelete: Restrict)
  yevmiyeFisi   YevmiyeFisi?   @relation(fields: [yevmiyeFisiId], references: [id], onDelete: Restrict)

  tahsisler TahsilatTahsisi[]

  @@index([tenantId, tahsilatTarihi])
  @@index([tenantId, kanal])
  @@index([tenantId, odeyenKisiId])
  @@map("tahsilat")
}

/// Tahsilat tahsisi — ödemenin HANGİ BORCA ne kadar gittiği.
///
/// ⚠️  BU TABLO OLMADAN "cari ekstre" DİYE BİR ŞEY YOKTUR. Ekstrenin ödeme
///     satırı burasıdır; yürüyen bakiye, borç satırları ile bu satırların
///     tarih sırasına göre birleşiminden çıkar.
///
/// ⚠️  `borcSorumlusuId` HİSSELİ MÜLKİYET İÇİN ZORUNLU AYRIMDIR. Borç
///     maliklere BÖLÜNÜR (`borc_sorumlusu.pay`); bir malik kendi payını
///     ödediğinde ötekilerin borcu AÇIK kalmalıdır. Tahsis yalnızca borca
///     bağlansaydı, bir malikin ödemesi bütün hissedarların borcunu kapatmış
///     görünürdü.
model TahsilatTahsisi {
  id         String @id @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  tahsilatId String @map("tahsilat_id") @db.Uuid
  borcId     String @map("borc_id") @db.Uuid
  /// Hisseli mülkiyette kimin payına sayıldığı. Tek sorumlu varsa boş kalabilir.
  borcSorumlusuId String? @map("borc_sorumlusu_id") @db.Uuid

  tutar Decimal @db.Decimal(18, 4)

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  tahsilat      Tahsilat       @relation(fields: [tahsilatId], references: [id], onDelete: Cascade)
  borc          Borc           @relation(fields: [borcId], references: [id], onDelete: Restrict)
  borcSorumlusu BorcSorumlusu? @relation(fields: [borcSorumlusuId], references: [id], onDelete: Restrict)

  @@index([tenantId, borcId])
  @@index([tenantId, tahsilatId])
  @@index([tenantId, borcSorumlusuId])
  @@map("tahsilat_tahsisi")
}

// ===========================================================================
// İLETİŞİM ÇEKİRDEĞİ (0019) — WhatsApp Business · SMS · (ileride e-posta)
//
// ⚠️  WHATSAPP ve SMS AYRI MODEL DEĞİLDİR. İkisi de "bir mesajı, bir alıcıya,
//     bir kanaldan gönder"dir; alıcı çözümü, şablonlar, toplu/zamanlanmış
//     gönderim, geçmiş, durum takibi ve izin denetimi ORTAKTIR. Ayrı
//     tutulsaydı bu iskelet iki kez yazılır ve biri düzeltildiğinde öteki
//     SESSİZCE eski davranmaya devam ederdi. Kanal bir ALANDIR.
//
// ⚠️  GERÇEK SAĞLAYICI BAĞLANTISI YOKTUR. Hiçbir mesaj TESLIM_EDILDI olarak
//     işaretlenmez; sağlayıcı yokken durum SAGLAYICI_YOK'ta kalır. Sahte bir
//     "teslim edildi", yöneticinin sakinleri bilgilendirdiğini sanmasına yol
//     açardı.
// ===========================================================================

enum IletisimKanali {
  WHATSAPP
  SMS
  EPOSTA
}

/// Hizmet ilişkisinden doğan BİLGİLENDİRME İYS iznine tabi değildir; TİCARİ
/// ileti tabidir (6563 s. K. md. 6). Ayrım yapılmasaydı ya bütün bildirimler
/// izne takılır ya da ticari ileti izinsiz giderdi — ikincisi idari para
/// cezasıdır.
enum IletiTuru {
  BILGILENDIRME
  TICARI
}

enum IletiIzinDurumu {
  IZIN
  RET
}

enum HedefTipi {
  TUM_SITE
  BLOK
  KAT
  DAIRE
  MALIK
  KIRACI
  SAKIN
  DAIRE_GOREVLISI
  YONETIM_KURULU
  KISILER
  GRUP
}

enum GonderimDurumu {
  TASLAK
  ZAMANLANDI
  GONDERILIYOR
  TAMAMLANDI
  IPTAL
}

/// ⚠️  `SAGLAYICI_YOK` AYRI BİR DURUMDUR, `BASARISIZ` DEĞİL. Başarısız,
///     sağlayıcının reddettiği mesajdır ve yeniden denenebilir. Sağlayıcı
///     yokluğu bir yapılandırma eksiğidir; "başarısız" sayılsaydı durum
///     raporunda operatör hatası gibi görünür ve gerçek hata oranı yanlış
///     okunurdu.
enum MesajDurumu {
  BEKLIYOR
  KUYRUKTA
  GONDERILDI
  TESLIM_EDILDI
  OKUNDU
  BASARISIZ
  IPTAL
  SAGLAYICI_YOK
  IZIN_YOK
}

model MesajSablonu {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  kod String @db.VarChar(60)
  ad  String @db.VarChar(160)
  /// Boşsa şablon HER kanalda kullanılabilir. SMS'e özel kısa metin ile
  /// WhatsApp'a özel uzun metin AYRI şablonlardır.
  kanal     IletisimKanali?
  iletiTuru IletiTuru       @default(BILGILENDIRME) @map("ileti_turu")

  /// Değişkenler `{{ad}}` biçimindedir. ÇÖZÜLMEYEN DEĞİŞKEN GÖNDERİMİ
  /// ENGELLER: "Sayın {{ad}}, {{tutar}} TL borcunuz var" mesajının ham
  /// hâliyle gitmesi yönetime olan güveni tek seferde bitirir.
  govde    String
  aciklama String?
  aktif    Boolean @default(true)

  silindiMi      Boolean   @default(false) @map("silindi_mi")
  silinmeTarihi  DateTime? @map("silinme_tarihi") @db.Timestamptz(6)
  silenKullanici String?   @map("silen_kullanici") @db.Uuid
  silmeGerekcesi String?   @map("silme_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant     Tenant                   @relation(fields: [tenantId], references: [id])
  gonderimler MesajGonderimi[]
  kurallar   OtomatikBildirimKurali[]

  @@index([tenantId, kanal])
  @@map("mesaj_sablonu")
}

/// İYS izni — kişi · kanal · ileti türü bazında.
///
/// ⚠️  RET, İZİN YOKLUĞUNDAN FARKLIDIR. İzin kaydı hiç yoksa TİCARİ ileti
///     gönderilemez; RET varsa BİLGİLENDİRME de dahil hiçbir şey gönderilmez
///     (kişi açıkça istememiştir). Tek bayrağa indirgenseydi "hiç sorulmamış"
///     ile "hayır demiş" ayırt edilemezdi.
model IletisimIzni {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  kisiId   String @map("kisi_id") @db.Uuid

  kanal     IletisimKanali
  iletiTuru IletiTuru       @map("ileti_turu")
  durum     IletiIzinDurumu

  /// İzin KANITI: nereden alındığı (sözleşme · form · İYS · sözlü beyan).
  /// Kanıtı olmayan izin, denetimde izin sayılmaz.
  kaynak       String   @db.VarChar(120)
  beyanTarihi  DateTime @map("beyan_tarihi") @db.Date
  gerekce      String?

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  kisi   Kisi   @relation(fields: [kisiId], references: [id])

  @@unique([tenantId, kisiId, kanal, iletiTuru])
  @@index([tenantId, kisiId])
  @@map("iletisim_izni")
}

/// Gönderim — bir parti (tekil ya da toplu).
model MesajGonderimi {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  kanal     IletisimKanali
  iletiTuru IletiTuru      @default(BILGILENDIRME) @map("ileti_turu")
  durum     GonderimDurumu @default(TASLAK)

  sablonId String? @map("sablon_id") @db.Uuid
  baslik   String? @db.VarChar(200)
  /// Şablon ÇÖZÜLMEDEN önceki gövde. Şablon sonradan değişse bile gönderilen
  /// metin `Mesaj.govde`de saklıdır; bu alan "ne yazılmıştı"yı gösterir.
  govde    String

  hedefTipi      HedefTipi @map("hedef_tipi")
  /// Hedefin kimliği. JSON çünkü şekli hedef tipine göre değişir; her tip için
  /// ayrı kolon açmak on boş kolon demekti.
  hedefReferansi Json?     @map("hedef_referansi")

  zamanlanmaAni DateTime? @map("zamanlanma_ani") @db.Timestamptz(6)
  baslamaAni    DateTime? @map("baslama_ani") @db.Timestamptz(6)
  bitisAni      DateTime? @map("bitis_ani") @db.Timestamptz(6)

  /// İLİŞKİLİ KAYIT: hangi tahakkuk/makbuz/arıza için gönderildi.
  ilgiliVarlik   String? @map("ilgili_varlik") @db.VarChar(60)
  ilgiliVarlikId String? @map("ilgili_varlik_id") @db.Uuid

  olusturan      String  @db.Uuid
  iptalGerekcesi String? @map("iptal_gerekcesi")

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  sablon   MesajSablonu? @relation(fields: [sablonId], references: [id], onDelete: Restrict)
  mesajlar Mesaj[]

  @@index([tenantId, durum])
  @@index([tenantId, kanal, olusturulmaTarihi])
  @@map("mesaj_gonderimi")
}

/// Mesaj — alıcı başına tek satır.
///
/// ⚠️  ALICI BİLGİSİ KOPYALANIR (ad ve numara). Kişi sonradan taşınsa ya da
///     numarası değişse bile "bu mesaj O GÜN şu numaraya gitti" bilgisi
///     değişmemelidir; ilişkiye bakılsaydı geçmiş sessizce yeniden yazılırdı.
model Mesaj {
  id         String @id @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  gonderimId String @map("gonderim_id") @db.Uuid

  kisiId String? @map("kisi_id") @db.Uuid
  /// SNAPSHOT — gönderim anındaki hâli.
  aliciAdi String @map("alici_adi") @db.VarChar(160)
  numara   String @db.VarChar(24)

  kanal IletisimKanali
  durum MesajDurumu    @default(BEKLIYOR)
  /// Şablon ÇÖZÜLMÜŞ hâli — gerçekten gönderilen metin.
  govde String

  /// SMS kontörü. Türkçe karakterler (ğ ı ş İ) GSM-7 alfabesinde YOKTUR;
  /// mesaj UCS-2'ye düşer ve parça uzunluğu 160'tan 70'e iner. Yanlış
  /// hesaplansa fatura sessizce iki katına çıkardı.
  parcaSayisi Int @default(1) @map("parca_sayisi")

  saglayici        String? @db.VarChar(60)
  saglayiciMesajId String? @map("saglayici_mesaj_id") @db.VarChar(120)
  hataKodu         String? @map("hata_kodu") @db.VarChar(60)
  hataMesaji       String? @map("hata_mesaji")
  denemeSayisi     Int     @default(0) @map("deneme_sayisi")

  gonderimAni DateTime? @map("gonderim_ani") @db.Timestamptz(6)
  teslimAni   DateTime? @map("teslim_ani") @db.Timestamptz(6)
  okunmaAni   DateTime? @map("okunma_ani") @db.Timestamptz(6)

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  gonderim MesajGonderimi @relation(fields: [gonderimId], references: [id], onDelete: Cascade)
  kisi     Kisi?          @relation(fields: [kisiId], references: [id], onDelete: Restrict)

  @@index([tenantId, gonderimId])
  @@index([tenantId, kisiId])
  @@index([tenantId, durum])
  @@index([tenantId, olusturulmaTarihi])
  @@map("mesaj")
}

/// Otomatik bildirim kuralı — olay → şablon eşlemesi.
///
/// ⚠️  KURAL VERİ OLARAK TUTULUR, KODA GÖMÜLMEZ (§33 kural 3). "Aidat
///     tahakkukunda SMS at" kodda olsaydı, SMS istemeyen bir tenant için
///     kapatılamazdı.
///
/// ⚠️  BU TABLO DOLU OLSA DA HİÇBİR ŞEY OTOMATİK GÖNDERİLMEZ: tetikleyici
///     bağlantısı (outbox tüketicisi) HENÜZ YOKTUR. Kural kaydı
///     "gönderilecek" anlamına gelmez.
model OtomatikBildirimKurali {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Outbox olay tipiyle eşleşir (ör. `tahakkuk.olusturuldu`).
  olayKodu String         @map("olay_kodu") @db.VarChar(80)
  kanal    IletisimKanali
  sablonId String         @map("sablon_id") @db.Uuid
  aktif    Boolean        @default(false)
  aciklama String?

  olusturulmaTarihi DateTime @default(now()) @map("olusturulma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi  DateTime @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  sablon MesajSablonu @relation(fields: [sablonId], references: [id], onDelete: Restrict)

  @@unique([tenantId, olayKodu, kanal])
  @@index([tenantId, olayKodu])
  @@map("otomatik_bildirim_kurali")
}
