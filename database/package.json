{
  "name": "@bnos/database",
  "version": "0.1.0",
  "private": true,
  "description": "BNOS Apartman Yönetimi — Prisma şeması, migration ve tohum verisi",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "seed": "tsx seeds/seed.ts",
    "build": "prisma generate",
    "typecheck": "tsc --noEmit"
  },
  "prisma": { "schema": "prisma/schema.prisma", "seed": "tsx seeds/seed.ts" },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@bnos/apartman-domain": "workspace:*"
  },
  "devDependencies": { "prisma": "^5.20.0", "tsx": "^4.19.0", "typescript": "^5.6.0" }
}
