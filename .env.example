# ---------------------------------------------------------------
# BNOS Apartman Yonetimi Modulu — ornek ortam degiskenleri
# `cp .env.example .env` ile kopyalayin.
# ---------------------------------------------------------------

NODE_ENV=development
TZ=UTC

# --- Veritabani ------------------------------------------------
# ONEMLI: uygulama rolu bnos_app'tir ve BYPASSRLS yetkisi YOKTUR (ADR-0002).
# Migration icin ayri rol kullanilir.
DATABASE_URL="postgresql://bnos_app:bnos_app_dev@localhost:5432/bnos_apartman?schema=public"
MIGRATE_DATABASE_URL="postgresql://bnos_migrator:bnos_migrator_dev@localhost:5432/bnos_apartman?schema=public"

# --- Redis (onbellek + BullMQ) ---------------------------------
REDIS_URL="redis://localhost:6379"

# --- S3 uyumlu nesne deposu ------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="minio12345"
S3_BUCKET="bnos-apartman"
S3_REGION="us-east-1"

# --- Kimlik (uc kapi — Kapi 1) ---------------------------------
JWT_SECRET="gelistirme-icin-degistirin-en-az-32-karakter-olmali"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Uygulama --------------------------------------------------
API_PORT=3001
API_PREFIX="/api/v1"
WEB_ORIGIN="http://localhost:3000"

# Kac ters vekil katmanina guvenilecek. 0 = hic (varsayilan, dogrudan erisim).
# Yuk dengeleyici arkasinda 1 yapin: aksi halde butun istekler tek adresten
# geliyor gorunur, IP sayaci bir sitenin TAMAMINI kilitler ve denetim
# kaydindaki IP yanlis olur. Yanlis ACMAK ise daha kotudur: dogrudan erisilen
# bir sunucuda istemci X-Forwarded-For'u kendisi yazar ve istek sinirini
# tumuyle atlar.
TRUST_PROXY=0
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# SAHTE VERI MODU. Varsayilan KAPALI ('0'): arayuz gercek backend'e baglanir.
#
# '1' yapilirsa ekranlar `frontend/web/lib/mock/veri.ts` icindeki uydurma
# kayitlarla calisir. Bu mod backend hazir olmadan arayuz gelistirmeyi
# saglar ama ACIK BIRAKILIRSA gosterilen her sayi UYDURMADIR.
#
# ⚠️ ACIKKEN EKRANIN USTUNDE UYARI BANDI GORUNUR ve bant KAPATILAMAZ:
#    kapatilabilseydi gelistirici kapatir, sonraki oturumda modun acik
#    oldugunu unuturdu.
#
# ⚠️ URETIMDE ASLA '1' OLMAZ.
NEXT_PUBLIC_MOCK="0"

# --- BNOS cekirdek servisleri ----------------------------------
# Sprint 15'e kadar yerel adaptorler kullanilir (AIS v1 §2).
BNOS_MODE="local"
BNOS_BASE_URL=""
BNOS_API_KEY=""
